0, "link": null, "locked": false, "index": "b2N", "hasTextLink": false, "text": "RGB product sums: -0.090747 + -0.171251 + 0.410423; add bias -0.111309 -> center response 0.037116.", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "RGB product sums: -0.090747 + -0.171251 + 0.410423; add bias -0.111309 -> center response 0.037116.", "lineHeight": 1.25, "autoResize": false, "rawText": "RGB product sums: -0.090747 + -0.171251 + 0.410423; add bias -0.111309 -> center response 0.037116."}, {"id": "rgb-neurons-148", "type": "text", "x": 60, "y": 1640, "width": 1880, "height": 37.5, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 840148, "version": 1, "versionNonce": 830148, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b2O", "hasTextLink": false, "text": "2. The final classifier multiplies FEATURES, not raw RGB again", "fontSize": 30, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "2. The final classifier multiplies FEATURES, not raw RGB again", "lineHeight": 1.25, "autoResize": false, "rawText": "2. The final classifier multiplies FEATURES, not raw RGB again"}, {"id": "rgb-neurons-149", "type": "text", "x": 60, "y": 1690, "width": 1880, "height": 26.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 840149, "version": 1, "versionNonce": 830149, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b2P", "hasTextLink": false, "text": "These four inputs were calculated from the image by convolution, ReLU and pooling. Four outputs need 4 x 4 connection weights.", "fontSize": 21, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "These four inputs were calculated from the image by convolution, ReLU and pooling. Four outputs need 4 x 4 connection weights.", "lineHeight": 1.25, "autoResize": false, "rawText": "These four inputs were calculated from the image by convolution, ReLU and pooling. Four outputs need 4 x 4 connection weights."}, {"id": "rgb-neurons-150", "type": "text", "x": 75, "y": 1750, "width": 620, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 840150, "version": 1, "versionNonce": 830150, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b2Q", "hasTextLink": false, "text": "Pooled features: green incoming values", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Pooled features: green incoming values", "lineHeight": 1.25, "autoResize": false, "rawText": "Pooled features: green incoming values"}, {"id": "rgb-neurons-151", "type": "text", "x": 1400, "y": 1750, "width": 550, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 840151, "version": 1, "versionNonce": 830151, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b2R", "hasTextLink": false, "text": "Final class logits, then softmax", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Final class logits, then softmax", "lineHeight": 1.25, "autoResize": false, "rawText": "Final class logi