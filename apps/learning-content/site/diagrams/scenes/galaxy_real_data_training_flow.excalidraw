ain-update-box", "type": "rectangle", "x": 500, "y": 500, "width": 350, "height": 245, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "#fff5f5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 217, "version": 1, "versionNonce": 100217, "isDeleted": false, "boundElements": [], "updated": 1789998400000, "link": null, "locked": false, "roundness": {"type": 3}}, {"id": "train-update-title", "type": "text", "x": 525, "y": 525, "width": 300, "height": 30.0, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 218, "version": 1, "versionNonce": 100218, "isDeleted": false, "boundElements": [], "updated": 1789998400000, "link": null, "locked": false, "text": "This is actual training", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "This is actual training", "lineHeight": 1.25, "autoResize": false, "rawText": "This is actual training", "hasTextLink": false}, {"id": "train-update-body", "type": "text", "x": 525, "y": 570, "width": 300, "height": 202.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 219, "version": 1, "versionNonce": 100219, "isDeleted": false, "boundElements": [], "updated": 1789998400000, "link": null, "locked": false, "text": "loss.backward()\n\nSGD optimizer.step()\n\nEach train batch changes\nconvolution + classifier\nweights and biases.\n\n2 epochs = 14 updates", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "loss.backward()\n\nSGD optimizer.step()\n\nEach train batch changes\nconvolution + classifier\nweights and biases.\n\n2 epochs = 14 updates", "lineHeight": 1.25, "autoResize": false, "rawText": "loss.backward()\n\nSGD optimizer.step()\n\nEach train batch changes\nconvolution + classifier\nweights and biases.\n\n2 epochs = 14 updates", "hasTextLink": false}, {"id": "train-eval-box", "type": "rectangle", "x": 940, "y": 500, "width": 350, "height": 245, "angle": 0, "strokeColor": "#2b8a3e", "backgroundColor": "#e6fcf5", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 220, "version": 1, "versionNonce": 100220, "isDeleted": false, "boundElements": [], "updated": 1789998400000, "link": null, "locked": false, "roundness": {"type": 3}}, {"id": "train-eval-title", "type": "text", "x": 965, "y": 525, "width": 300, "height": 30.0, "angle": 0, "strokeColor": "#2b8a3e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 221, "version": 1, "versionNonce": 100221, "isDeleted": false, "boundElements": [], "updated": 1789998400000, "link": null, "locked": false, "text": "Validation / test path", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Validation / test path", "lineHeight": 1.25, "autoResize": false, "rawText": "Validation / test path", "hasTextLink": false}, {"id": "train-eval-body", "type": "text", "x": 965, "y": 570, "width": 300, "height": 202.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 222, "version": 1, "versionNonce": 100222, "isDeleted": false, "boundElements": [], "updated": 1789998400000, "link": null, "locked": false, "text": "12 val + 12 test images\n\nmodel.eval() + no_grad()\nforward -> loss, prediction,\naccuracy, probabilities\n\nNo backward()\nNo optimizer.step()\nWeights stay unchanged", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "12 val + 12 test images\n\nmodel.eval() + no_grad()\nforward -> loss, prediction,\naccuracy, probabilities\n\nNo backward()\nNo optimizer.step()\nWeights stay unchanged", "lineHeight": 1.25, "autoResize": false, "rawText": "12 val + 12 test images\n\nmodel.eval() + no_grad()\nforward -> loss, prediction,\naccuracy, probabilities\n\nNo backward()\nNo optimizer.step()\nWeights stay unchanged", "hasTextLink": false}, {"id": "train-a3", "type": "arrow", "x": 1025, "y": 390, "width": -350, "height": 110, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 223, "version": 1, "versionNonce": 100223, "isDeleted": false, "boundElements": [], "updated": 1789998400000, "link": null, "locked": false, "points": [[0, 0], [-350, 110]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "train-a4", "type": "arrow", "x": 1025, "y": 390, "width": 90, "height": 110, "angle": 0, "strokeColor": "#2b8a3e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 224, "version": 1, "versionNonce": 100224, "isDeleted": false, "boundElements": [], "updated": 1789998400000, "link": null, "locked": false, "points": [[0, 0], [90, 110]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "train-result-box", "type": "rectangle", "x": 60, "y": 830, "width": 1230, "height": 125, "angle": 0, "strokeColor": "#495057", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 225, "version": 1, "versionNonce": 100225, "isDeleted": false, "boundElements": [], "updated": 1789998400000, "link": null, "locked": false, "roundness": {"type": 3}}, {"id": "train-result-title", "type": "text", "x": 85, "y": 855, "width": 400, "height": 28, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 226, "version": 1, "versionNonce": 100226, "isDeleted": false, "boundElements": [], "updated": 1789998400000, "link": null, "locked": false, "text": "What did this pilot prove?", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "What did this pilot prove?", "lineHeight": 1.25, "autoResize": false, "rawText": "What did this pilot prove?", "hasTextLink": false}, {"id": "train-result-body", "type": "text", "x": 85, "y": 900, "width": 1160, "height": 28, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 227, "version": 1, "versionNonce": 100227, "isDeleted": false, "boundElements": [], "updated": 1789998400000, "link": null, "locked": false, "text": "Real baseline run: average loss 1.4140 -> 1.4069; train, validation, and test accuracy were each 0.2500. That proves the data loader, CNN, backward pass, SGD update, evaluation, and checkpoint reload work together. It does not establish useful galaxy-classification accuracy from only 80 images.", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Real baseline run: average loss 1.4140 -> 1.4069; train, validation, and test accuracy were each 0.2500. That proves the data loader, CNN, backward pass, SGD update, evaluation, and checkpoint reload work together. It does not establish useful galaxy-classification accuracy from only 80 images.", "lineHeight": 1.25, "autoResize": false, "rawText": "Real baseline run: average loss 1.4140 -> 1.4069; train, validation, and test accuracy were each 0.2500. That proves the data loader, CNN, backward pass, SGD update, evaluation, and checkpoint reload work together. It does not establish useful galaxy-classification accuracy from only 80 images.", "hasTextLink": false}], "appState": {"viewBackgroundColor": "#ffffff"}, "files": {}}