{"type": "excalidraw", "version": 2, "source": "CosmosAI learning export", "elements": [{"id": "train-title", "type": "text", "x": 60, "y": 35, "width": 1380, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 201, "version": 1, "versionNonce": 100201, "isDeleted": false, "boundElements": [], "updated": 1789998400000, "link": null, "locked": false, "text": "Real Galaxy Zoo pilot: download, train, evaluate", "fontSize": 32, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Real Galaxy Zoo pilot: download, train, evaluate", "lineHeight": 1.25, "autoResize": false, "rawText": "Real Galaxy Zoo pilot: download, train, evaluate", "hasTextLink": false}, {"id": "train-subtitle", "type": "text", "x": 60, "y": 88, "width": 1380, "height": 28, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 202, "version": 1, "versionNonce": 100202, "isDeleted": false, "boundElements": [], "updated": 1789998400000, "link": null, "locked": false, "text": "The same downloaded images are read in different ways: train updates weights; validation and test only measure them.", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The same downloaded images are read in different ways: train updates weights; validation and test only measure them.", "lineHeight": 1.25, "autoResize": false, "rawText": "The same downloaded images are read in different ways: train updates weights; validation and test only measure them.", "hasTextLink": false}, {"id": "train-data-box", "type": "rectangle", "x": 60, "y": 160, "width": 300, "height": 230, "angle": 0, "strokeColor": "#2b