{"type": "excalidraw", "version": 2, "source": "CosmosAI learning export", "elements": [{"id": "title", "type": "text", "x": 60, "y": 40, "width": 1280, "height": 44, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000001, "version": 1, "versionNonce": 480000011, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a1", "hasTextLink": false, "text": "Gradient, Backpropagation, And Weight Change", "fontSize": 34, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Gradient, Backpropagation, And Weight Change", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "subtitle", "type": "text", "x": 60, "y": 96, "width": 1500, "height": 30, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000002, "version": 1, "versionNonce": 480000021, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": "/learn/concepts/#concept-gradient-backprop-logic-flow", "locked": false, "index": "a2", "hasTextLink": true, "text": "Concept doc: forward pass uses weights; backward calculates gradients; optimizer.step changes weights.", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Concept doc: forward pass uses weights; backward calculates gradients; optimizer.step changes weights.", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "row1-label", "type": "text", "x": 60, "y": 150, "width": 700, "height": 34, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000003, "version": 1, "versionNonce": 480000031, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": "/learn/concepts/#concept-gradient-calculation-example", "locked": false, "index": "a3", "hasTextLink": true, "text": "1. Small neuron example: one weight changes", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "1. Small neuron example: one weight changes", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "input-box", "type": "rectangle", "x": 60, "y": 210, "width": 310, "height": 190, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000004, "version": 1, "versionNonce": 480000041, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a4", "roundness": {"type": 3}}, {"id": "input-text", "type": "text", "x": 84, "y": 234, "width": 260, "height": 135, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000005, "version": 1, "versionNonce": 480000051, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a5", "hasTextLink": false, "text": "Input and target\n\ninput x = 2\nold weight w = 0.5\ntarget = 4\nlearning_rate = 0.1", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Input and target\n\ninput x = 2\nold weight w = 0.5\ntarget = 4\nlearning_rate = 0.1", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "forward-box", "type": "rectangle", "x": 460, "y": 210, "width": 340, "height": 190, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000006, "version": 1, "versionNonce": 480000061, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": "/learn/concepts/#concept-forward-pass", "locked": false, "index": "a6", "roundness": {"type": 3}}, {"id": "forward-text", "type": "text", "x": 486, "y": 234, "width": 285, "height": 135, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000007, "version": 1, "versionNonce": 480000071, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": "/learn/concepts/#concept-forward-pass", "locked": false, "index": "a7", "hasTextLink": true, "text": "Forward pass\n\nprediction = x * w\nprediction = 2 * 0.5\nprediction = 1\n\nWeight is used here,\nnot changed yet.", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Forward pass\n\nprediction = x * w\nprediction = 2 * 0.5\nprediction = 1\n\nWeight is used here,\nnot changed yet.", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "gradient-box", "type": "rectangle", "x": 900, "y": 210, "width": 380, "height": 190, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000008, "version": 1, "versionNonce": 480000081, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": "/learn/concepts/#concept-gradient", "locked": false, "index": "a8", "roundness": {"type": 3}}, {"id": "gradient-text", "type": "text", "x": 926, "y": 234, "width": 325, "height": 135, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000009, "version": 1, "versionNonce": 480000091, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": "/learn/concepts/#concept-gradient", "locked": false, "index": "a9", "hasTextLink": true, "text": "Loss and gradient\n\nerror = 1 - 4 = -3\nloss = error^2 = 9\n\ngradient = 2 * error * input\ngradient = 2 * -3 * 2 = -12", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Loss and gradient\n\nerror = 1 - 4 = -3\nloss = error^2 = 9\n\ngradient = 2 * error * input\ngradient = 2 * -3 * 2 = -12", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "update-box", "type": "rectangle", "x": 1380, "y": 210, "width": 390, "height": 190, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000010, "version": 1, "versionNonce": 480000101, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": "/learn/concepts/#concept-optimizer-step", "locked": false, "index": "a10", "roundness": {"type": 3}}, {"id": "update-text", "type": "text", "x": 1406, "y": 234, "width": 335, "height": 135, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000011, "version": 1, "versionNonce": 480000111, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": "/learn/concepts/#concept-optimizer-step", "locked": false, "index": "a11", "hasTextLink": true, "text": "Optimizer update\n\nnew_w = old_w - lr * gradient\nnew_w = 0.5 - 0.1 * -12\nnew_w = 1.7\n\nNegative gradient -> weight goes up.", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Optimizer update\n\nnew_w = old_w - lr * gradient\nnew_w = 0.5 - 0.1 * -12\nnew_w = 1.7\n\nNegative gradient -> weight goes up.", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "after-box", "type": "rectangle", "x": 1870, "y": 210, "width": 350, "height": 190, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000012, "version": 1, "versionNonce": 480000121, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a12", "roundness": {"type": 3}}, {"id": "after-text", "type": "text", "x": 1896, "y": 234, "width": 295, "height": 135, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000013, "version": 1, "versionNonce": 480000131, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a13", "hasTextLink": false, "text": "Next forward pass\n\nnew prediction = 2 * 1.7\nnew prediction = 3.4\n\ntarget = 4\nloss is now lower.", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Next forward pass\n\nnew prediction = 2 * 1.7\nnew prediction = 3.4\n\ntarget = 4\nloss is now lower.", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "row2-label", "type": "text", "x": 60, "y": 500, "width": 900, "height": 34, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000014, "version": 1, "versionNonce": 480000141, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a14", "hasTextLink": true, "text": "2. Live project CNN example: one training step changes weights", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "2. Live project CNN example: one training step changes weights", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "cnn-input-box", "type": "rectangle", "x": 60, "y": 565, "width": 340, "height": 220, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000015, "version": 1, "versionNonce": 480000151, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a15", "roundness": {"type": 3}}, {"id": "cnn-input-text", "type": "text", "x": 86, "y": 591, "width": 285, "height": 160, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000016, "version": 1, "versionNonce": 480000161, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a16", "hasTextLink": true, "text": "run_torch_training_step()\n\nInput sample:\nimage_id = gz2-000001\ntrue label = spiral\nlabel_id = 1\nshape = (1, 3, 3, 3)", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "run_torch_training_step()\n\nInput sample:\nimage_id = gz2-000001\ntrue label = spiral\nlabel_id = 1\nshape = (1, 3, 3, 3)", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "cnn-before-box", "type": "rectangle", "x": 500, "y": 565, "width": 410, "height": 220, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000017, "version": 1, "versionNonce": 480000171, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a17", "roundness": {"type": 3}}, {"id": "cnn-before-text", "type": "text", "x": 526, "y": 591, "width": 355, "height": 160, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000018, "version": 1, "versionNonce": 480000181, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a18", "hasTextLink": true, "text": "Forward before update\n\ncurrent CNN weights -> logits\nsoftmax -> probabilities\n\nspiral probability = 0.2949\nloss_before = 1.2211\nprediction before = class 0", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Forward before update\n\ncurrent CNN weights -> logits\nsoftmax -> probabilities\n\nspiral probability = 0.2949\nloss_before = 1.2211\nprediction before = class 0", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "backward-box", "type": "rectangle", "x": 1010, "y": 565, "width": 380, "height": 220, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000019, "version": 1, "versionNonce": 480000191, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a19", "roundness": {"type": 3}}, {"id": "backward-text", "type": "text", "x": 1036, "y": 591, "width": 325, "height": 160, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000020, "version": 1, "versionNonce": 480000201, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a20", "hasTextLink": true, "text": "loss.backward()\n\nBackpropagation calculates gradients.\n\nGradient meaning:\nhow each weight affected loss\nand which direction should reduce it.", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "loss.backward()\n\nBackpropagation calculates gradients.\n\nGradient meaning:\nhow each weight affected loss\nand which direction should reduce it.", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "optim-box", "type": "rectangle", "x": 1490, "y": 565, "width": 390, "height": 220, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000021, "version": 1, "versionNonce": 480000211, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a21", "roundness": {"type": 3}}, {"id": "optim-text", "type": "text", "x": 1516, "y": 591, "width": 335, "height": 160, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000022, "version": 1, "versionNonce": 480000221, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a22", "hasTextLink": true, "text": "optimizer.step()\n\nThis is where weights change.\n\nRule idea:\nnew_weight = old_weight - lr * gradient\n\nweight_changed = True", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "optimizer.step()\n\nThis is where weights change.\n\nRule idea:\nnew_weight = old_weight - lr * gradient\n\nweight_changed = True", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "cnn-after-box", "type": "rectangle", "x": 1980, "y": 565, "width": 410, "height": 220, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000023, "version": 1, "versionNonce": 480000231, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a23", "roundness": {"type": 3}}, {"id": "cnn-after-text", "type": "text", "x": 2006, "y": 591, "width": 355, "height": 160, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000024, "version": 1, "versionNonce": 480000241, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a24", "hasTextLink": true, "text": "Forward after update\n\nsame image, changed weights\n-> new logits/probabilities\n\nspiral probability = 0.3235\nloss_after = 1.1285\nprediction after = class 1", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Forward after update\n\nsame image, changed weights\n-> new logits/probabilities\n\nspiral probability = 0.3235\nloss_after = 1.1285\nprediction after = class 1", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "bottom-note", "type": "text", "x": 60, "y": 840, "width": 1900, "height": 58, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000025, "version": 1, "versionNonce": 480000251, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a25", "hasTextLink": false, "text": "Important: lower loss is the goal, but weights do not all go down. Each weight moves up, down, or barely moves based on its own gradient.", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Important: lower loss is the goal, but weights do not all go down. Each weight moves up, down, or barely moves based on its own gradient.", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "arrow-1", "type": "arrow", "x": 380, "y": 305, "width": 70, "height": 0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000026, "version": 1, "versionNonce": 480000261, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a26", "points": [[0, 0], [70, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "arrow-2", "type": "arrow", "x": 810, "y": 305, "width": 80, "height": 0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000027, "version": 1, "versionNonce": 480000271, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a27", "points": [[0, 0], [80, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "arrow-3", "type": "arrow", "x": 1290, "y": 305, "width": 80, "height": 0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent",