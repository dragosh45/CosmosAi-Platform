, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a31", "points": [[0, 0], [80, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "arrow-7", "type": "arrow", "x": 1400, "y": 675, "width": 80, "height": 0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000032, "version": 1, "versionNonce": 480000321, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a32", "points": [[0, 0], [80, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "arrow-8", "type": "arrow", "x": 1890, "y": 675, "width": 80, "height": 0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000033, "version": 1, "versionNonce": 480000331, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": null, "locked": false, "index": "a33", "points": [[0, 0], [80, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "high-loss-gradient-box", "type": "rectangle", "x": 60, "y": 940, "width": 720, "height": 210, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000034, "version": 1, "versionNonce": 480000341, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": "/learn/concepts/#concept-gradient", "locked": false, "index": "a34", "roundness": {"type": 3}}, {"id": "high-loss-gradient-text", "type": "text", "x": 88, "y": 968, "width": 660, "height": 150, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000035, "version": 1, "versionNonce": 480000351, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": "/learn/concepts/#concept-gradient", "locked": false, "index": "a35", "hasTextLink": true, "text": "High loss vs gradient size\n\nHigh loss does NOT automatically mean a lower gradient.\nIt also does not mean every gradient is big.\n\nGradient size depends on how much one specific weight affected this mistake.", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "High loss vs gradient size\n\nHigh loss does NOT automatically mean a lower gradient.\nIt also does not mean every gradient is big.\n\nGradient size depends on how much one specific weight affected this mistake.", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "negative-gradient-box", "type": "rectangle", "x": 900, "y": 940, "width": 760, "height": 210, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000036, "version": 1, "versionNonce": 480000361, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": "/learn/concepts/#concept-optimizer-step", "locked": false, "index": "a36", "roundness": {"type": 3}}, {"id": "negative-gradient-text", "type": "text", "x": 928, "y": 968, "width": 700, "height": 150, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000037, "version": 1, "versionNonce": 480000371, "isDeleted": false, "boundElements": [], "updated": 1787150000000, "link": "/learn/concepts/#concept-optimizer-step", "locked": false, "index": "a37", "hasTextLink": true, "text": "Negative gradient and connection strength\n\nnew_weight = old_weight - lr * gradient\n0.20 - 0.10 * -0.30 = 0.23\n\nFor a positive input, this connection now pushes more strongly into the next neuron.", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Negative gradient and connection strength\n\nnew_weight = old_weight - lr * gradient\n0.20 - 0.10 * -0.30 = 0.23\n\nFor a positive input, this connection now pushes more strongly into the next neuron.", "lineHeight": 1.25, "autoResize": false, "rawText": ""}], "appState": {"viewBackgroundColor": "#ffffff"}, "files": {}}