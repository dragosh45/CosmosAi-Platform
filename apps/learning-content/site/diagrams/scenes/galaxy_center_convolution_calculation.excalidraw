90, "y": 1735, "width": 640, "height": 30, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 520043, "version": 2, "versionNonce": 707895291, "isDeleted": false, "boundElements": [], "updated": 1789548934402, "link": null, "locked": false, "index": "ah", "hasTextLink": false, "text": "Top-left window needs padding", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Top-left window needs padding", "lineHeight": 1.25, "autoResize": false, "rawText": "Top-left window needs padding", "roundness": null}, {"id": "EoYKeIs6", "type": "text", "x": 90, "y": 1790, "width": 640, "height": 202.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 520044, "version": 2, "versionNonce": 53784885, "isDeleted": false, "boundElements": [], "updated": 1789548934402, "link": null, "locked": false, "index": "ai", "hasTextLink": false, "text": "red patch centered at output (0,0)\n\n[ 0 PAD  0 PAD       0 PAD     ]\n[ 0 PAD  input R00   input R01 ]\n[ 0 PAD  input R10   input R11 ]\n\nAll RGB products + bias = -0.101113\nPadding zeros are inputs to this calculation;\nthey do not force its output to zero.", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "red patch centered at output (0,0)\n\n[ 0 PAD  0 PAD       0 PAD     ]\n[ 0 PAD  input R00   input R01 ]\n[ 0 PAD  input R10   input R11 ]\n\nAll RGB products + bias = -0.101113\nPadding zeros are inputs to this calculation;\nthey do not force its output to zero.", "lineHeight": 1.25, "autoResize": false, "rawText": "red patch centered at output (0,0)\n\n[ 0 PAD  0 PAD       0 PAD     ]\n[ 0 PAD  input R00   input R01 ]\n[ 0 PAD  input R10   input R11 ]\n\nAll RGB products + bias = -0.101113\nPadding zeros are inputs to this calculation;\nthey do not force its output to zero.", "roundness": null}, {"id": "maps-box", "type": "rectangle", "x": 820, "y": 1710, "width": 760, "height": 400, "angle": 0, "strokeColor": "#c92a2e", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 520045, "version": 2, "versionNonce": 2089937051, "isDeleted": false, "boundElements": [], "updated": 1789548934402, "link": null, "locked": false, "index": "aj", "roundness": {"type": 3}, "hasTextLink": false}, {"id": "9af5F3ry", "type": "text", "x": 850, "y": 1735, "width": 700, "height": 30, "angle": 0, "strokeColor": "#c92a2e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 520046, "version": 2, "versionNonce": 1012056725, "isDeleted": false, "boundElements": [], "updated": 1789548934402, "link": null, "locked": false, "index": "ak", "hasTextLink": false, "text": "Nine pre-ReLU responses -> ReLU", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Nine pre-ReLU responses -> ReLU", "lineHeight": 1.25, "autoResize": false, "rawText": "Nine pre-ReLU responses -> ReLU", "roundness": null}, {"id": "deNj0LBa", "type": "text", "x": 850, "y": 1790, "width": 700, "height": 191.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 520047, "version": 2, "versionNonce": 2032147771, "isDeleted": false, "boundElements": [], "updated": 1789548934402, "link": null, "locked": false, "index": "al", "hasTextLink": false, "text": "PRE-ReLU z\n[ -0.101113  -0.099339  -0.194985 ]\n[ +0.012275  +0.037116  -0.229769 ]\n[ +0.057834  +0.078752  -0.071123 ]\n\nPOST-ReLU max(0,z)\n[  0.000000   0.000000   0.000000 ]\n[ +0.012275  +0.037116   0.000000 ]\n[ +0.057834  +0.078752   0.000000 ]", "fontSize": 17, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "PRE-ReLU z\n[ -0.101113  -0.099339  -0.194985 ]\n[ +0.012275  +0.037116  -0.229769 ]\n[ +0.057834  +0.078752  -0.071123 ]\n\nPOST-ReLU max(0,z)\n[  0.000000   0.000000   0.000000 ]\n[ +0.012275  +0.037116   0.000000 ]\n[ +0.057834  +0.078752   0.000000 ]", "lineHeight": 1.25, "autoResize": false, "rawText": "PRE-ReLU z\n[ -0.101113  -0.099339  -0.194985 ]\n[ +0.012275  +0.037116  -0.229769 ]\n[ +0.057834  +0.078752  -0.071123 ]\n\nPOST-ReLU max(0,z)\n[  0.000000   0.000000   0.000000 ]\n[ +0.012275  +0.037116   0.000000 ]\n[ +0.057834  +0.078752   0.000000 ]", "roundness": null}, {"id": "KgjJTOlZ", "type": "text", "x": 850, "y": 2040, "width": 700, "height": 45, "angle": 0, "strokeColor": "#c92a2e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 520048, "version": 2, "versionNonce": 1046980597, "isDeleted": false, "boundElements": [], "updated": 1789548934402, "link": null, "locked": false, "index": "am", "hasTextLink": false, "text": "Every pre-ReLU z cell is a NEW 27-products + same bias calculation.\nDisplayed post-ReLU zeros are where negative z values were blocked.", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Every pre-ReLU z cell is a NEW 27-products + same bias calculation.\nDisplayed post-ReLU zeros are where negative z values were blocked.", "lineHeight": 1.25, "autoResize": false, "rawText": "Every pre-ReLU z cell is a NEW 27-products + same bias calculation.\nDisplayed post-ReLU zeros are where negative z values were blocked.", "roundness": null}, {"id": "pool-box", "type": "rectangle", "x": 1640, "y": 1710, "width": 700, "height": 400, "angle": 0, "strokeColor": "#2b8a3e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 520049, "version": 2, "versionNonce": 2067709403, "isDeleted": false, "boundElements": [], "updated": 1789548934402, "link": null, "locked": false, "index": "an", "roundness": {"type": 3}, "hasTextLink": false}, {"id": "Azr06A6x", "type": "text", "x": 1670, "y": 1735, "width": 640, "height": 30, "angle": 0, "strokeColor": "#2b8a3e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 520050, "version": 2, "versionNonce": 1803084117, "isDeleted": false, "boundElements": [], "updated": 1789548934402, "link": null, "locked": false, "index": "ao", "hasTextLink": false, "text": "Average all nine map entries", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Average all nine map entries", "lineHeight": 1.25, "autoResize": false, "rawText": "Average all nine map entries", "roundness": null}, {"id": "5GEuncnO", "type": "text", "x": 1670, "y": 1790, "width": 640, "height": 237.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 520051, "version": 2, "versionNonce": 1308641915, "isDeleted": false, "boundElements": [], "updated": 1789548934402, "link": null, "locked": false, "index": "ap", "hasTextLink": false, "text": "sum positives\n= 0.012274810 + 0.037116095\n  + 0.057833735 + 0.078752242\n= 0.185976882\n\na[0] = 0.185976882 / 9\n     = 0.020664100\n\nThis is ONE pooled feature,\nnot a class probability.", "fontSize": 19, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "sum positives\n= 0.012274810 + 0.037116095\n  + 0.057833735 + 0.078752242\n= 0.185976882\n\na[0] = 0.185976882 / 9\n     = 0.020664100\n\nThis is ONE pooled feature,\nnot a class probability.", "lineHeight": 1.25, "autoResize": false, "rawText": "sum positives\n= 0.012274810 + 0.037116095\n  + 0.057833735 + 0.078752242\n= 0.185976882\n\na[0] = 0.185976882 / 9\n     = 0.020664100\n\nThis is ONE pooled feature,\nnot a class probability.", "roundness": null}, {"id": "sgEt7hub", "type": "text", "x": 60, "y": 2170, "width": 900, "height": 27.5, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 520052, "version": 2, "versionNonce": 1222373045, "isDeleted": false, "boundElements": [], "updated": 1789548934402, "link": null, "locked": false, "index": "aq", "hasTextLink": true, "text": "Concept: kernel slices and the full center calculation", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Concept: kernel slices and the full center calculation", "lineHeight": 1.25, "autoResize": false, "rawText": "Concept: kernel slices and the full center calculation", "roundness": null}, {"id": "w0Vs2kqK", "type": "text", "x": 1010, "y": 2170, "width": 610, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 520053, "version": 2, "versionNonce": 908542747, "isDeleted": false, "boundElements": [], "updated": 1789548934402, "link": null, "locked": false, "index": "ar", "hasTextLink": true, "text": "Code: Conv2d, ReLU, pooling", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Code: Conv2d, ReLU, pooling", "lineHeight": 1.25, "autoResize": false, "rawText": "Code: Conv2d, ReLU, pooling", "roundness": null}, {"id": "n6kxWQ0W", "type": "text", "x": 1670, "y": 2170, "width": 670, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 520054, "version": 2, "versionNonce": 355880981, "isDeleted": false, "boundElements": [], "updated": 1789548934402, "link": null, "locked": false, "index": "as", "hasTextLink": true, "text": "Data: exact saved observation", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Data: exact saved observation", "lineHeight": 1.25, "autoResize": false, "rawText": "Data: exact saved observation", "roundness": null}, {"id": "footer", "type": "text", "x": 60, "y": 2230, "width": 2280, "height": 26.25, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 520055, "version": 2, "versionNonce": 1009133499, "isDeleted": false, "boundElements": [], "updated": 1789548934402, "link": null, "locked": false, "index": "at", "hasTextLink": false, "text": "Next: filters 1-3 repeat this entire calculation with different weights. Their four pooled features enter the separate 4x4 classifier.", "fontSize": 21, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Next: filters 1-3 repeat this entire calculation with different weights. Their four pooled features enter the separate 4x4 classifier.", "lineHeight": 1.25, "autoResize": false, "rawText": "Next: filters 1-3 repeat this entire calculation with different weights. Their four pooled features enter the separate 4x4 classifier.", "roundness": null}], "appState": {"viewBackgroundColor": "#ffffff"}, "files": {}}