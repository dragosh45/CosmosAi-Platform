": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 12045, "version": 2, "versionNonce": 1216545, "isDeleted": false, "boundElements": [], "updated": 1785520000000, "link": null, "locked": false, "index": "ds1", "hasTextLink": false}, {"id": "call-concept-text", "type": "text", "x": 1065, "y": 1015, "width": 675, "height": 151.20000000000002, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 12046, "version": 2, "versionNonce": 1216646, "isDeleted": false, "boundElements": [], "updated": 1785520000000, "link": null, "locked": false, "index": "dt1", "hasTextLink": false, "text": "Concept translation\n\nforward() = fake model calculation\nlogits = raw class scores\nsoftmax() = scores -> probabilities\ncross_entropy_loss() = compare probability with true label\nrun_training_loop() = repeat over epochs and train samples", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Concept translation\n\nforward() = fake model calculation\nlogits = raw class scores\nsoftmax() = scores -> probabilities\ncross_entropy_loss() = compare probability with true label\nrun_training_loop() = repeat over epochs and train samples", "lineHeight": 1.25, "autoResize": true, "rawText": ""}, {"id": "call-boundary-box", "type": "rectangle", "x": 1040, "y": 1285, "width": 720, "height": 250, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 12047, "version": 2, "versionNonce": 1216747, "isDeleted": false, "boundElements": [], "updated": 1785520000000, "link": null, "locked": false, "index": "du1", "hasTextLink": false}, {"id": "call-boundary-text", "type": "text", "x": 1065, "y": 1310, "width": 675, "height": 194.4, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 12048, "version": 2, "versionNonce": 1216848, "isDeleted": false, "boundElements": [], "updated": 1785520000000, "link": null, "locked": false, "index": "dv1", "hasTextLink": false, "text": "What is mocked here?\n\nNo convolution layers.\nNo learned weights.\nNo backpropagation.\nNo optimizer.step().\nNo checkpoint.\n\nThe code only rehearses the training shape.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "What is mocked here?\n\nNo convolution layers.\nNo learned weights.\nNo backpropagation.\nNo optimizer.step().\nNo checkpoint.\n\nThe code only rehearses the training shape.", "lineHeight": 1.25, "autoResize": true, "rawText": ""}, {"id": "seq-title", "type": "text", "x": 55, "y": 1625, "width": 758.88, "height": 32.400000000000006, "angle": 0, "strokeColor": "#5f3dc4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 12049, "version": 2, "versionNonce": 1216949, "isDeleted": false, "boundElements": [], "updated": 1785520000000, "link": null, "locked": false, "index": "dw1", "hasTextLink": false, "text": "4. Sequence diagram: one command-line run over time", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "4. Sequence diagram: one command-line run over time", "lineHeight": 1.25, "autoResize": true, "rawText": ""}, {"id": "seq-head-Terminal", "type": "text", "x": 80, "y": 1685, "width": 240, "height": 24, "angle": 0, "strokeColor": "#5f3dc4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness"