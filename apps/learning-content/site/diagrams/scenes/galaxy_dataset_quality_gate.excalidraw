{"type": "excalidraw", "version": 2, "source": "CosmosAI learning export", "elements": [{"id": "m50-title", "type": "text", "x": 80, "y": 40, "width": 1320, "height": 40, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500001, "version": 1, "versionNonce": 501001, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c00", "hasTextLink": false, "text": "Milestone 50: which rows are allowed to reach training?", "fontSize": 32, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Milestone 50: which rows are allowed to reach training?", "lineHeight": 1.25, "autoResize": false, "rawText": "Milestone 50: which rows are allowed to reach training?"}, {"id": "m50-subtitle", "type": "text", "x": 80, "y": 92, "width": 1320, "height": 25, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500002, "version": 1, "versionNonce": 501002, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c01", "hasTextLink": true, "text": "Concept: accepted, intentionally skipped missing, and rejected", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Concept: accepted, intentionally skipped missing, and rejected", "lineHeight": 1.25, "autoResize": false, "rawText": "Concept: accepted, intentionally skipped missing, and rejected"}, {"id": "m50-manifest-box", "type": "rectangle", "x": 80, "y": 165, "width": 540, "height": 245, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500003, "version": 1, "versionNonce": 501003, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c02", "roundness": {"type": 3}}, {"id": "m50-manifest-title", "type": "text", "x": 105, "y": 190, "width": 490, "height": 30, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500004, "version": 1, "versionNonce": 501004, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c03", "hasTextLink": true, "text": "1. validate_manifest()", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "1. validate_manifest()", "lineHeight": 1.25, "autoResize": false, "rawText": "1. validate_manifest()"}, {"id": "m50-manifest-body", "type": "text", "x": 105, "y": 238, "width": 490, "height": 145, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500005, "version": 1, "versionNonce": 501005, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c04", "hasTextLink": false, "text": "Checks CSV quoting and row length.\nChecks required fields, label, split,\nsource, and duplicate image_id.\n\nFailure names the exact row + field.\nNo record or CNN input is created.", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Checks CSV quoting and row length.\nChecks required fields, label, split,\nsource, and duplicate image_id.\n\nFailure names the exact row + field.\nNo record or CNN input is created.", "lineHeight": 1.25, "autoResize": false, "rawText": "Checks CSV quoting and row length.\nChecks required fields, label, split,\nsource, and duplicate image_id.\n\nFailure names the exact row + field.\nNo record or CNN input is created."}, {"id": "m50-arrow-1", "type": "arrow", "x": 640, "y": 285, "width": 135, "height": 0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500006, "version": 1, "versionNonce": 501006, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c05", "points": [[0, 0], [135, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "m50-record", "type": "rectangle", "x": 795, "y": 205, "width": 430, "height": 160, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#d0ebff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500007, "version": 1, "versionNonce": 501007, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c06", "roundness": {"type": 3}}, {"id": "m50-record-text", "type": "text", "x": 820, "y": 230, "width": 380, "height": 110, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500008, "version": 1, "versionNonce": 501008, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c07", "hasTextLink": true, "text": "GalaxyManifestRecord\n\nimage_id + path + label + split\nsource + manifest_row\n(row is diagnostics, not model data)", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "GalaxyManifestRecord\n\nimage_id + path + label + split\nsource + manifest_row\n(row is diagnostics, not model data)", "lineHeight": 1.25, "autoResize": false, "rawText": "GalaxyManifestRecord\n\nimage_id + path + label + split\nsource + manifest_row\n(row is diagnostics, not model data)"}, {"id": "m50-arrow-2", "type": "arrow", "x": 1010, "y": 385, "width": 0, "height": 120, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500009, "version": 1, "versionNonce": 501009, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c08", "points": [[0, 0], [0, 120]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "m50-gate", "type": "rectangle", "x": 720, "y": 525, "width": 580, "height": 230, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500010, "version": 1, "versionNonce": 501010, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c09", "roundness": {"type": 3}}, {"id": "m50-gate-title", "type": "text", "x": 745, "y": 550, "width": 530, "height": 30, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500011, "version": 1, "versionNonce": 501011, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c0a", "hasTextLink": true, "text": "2. create_dataset_splits() quality gate", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "2. create_dataset_splits() quality gate", "lineHeight": 1.25, "autoResize": false, "rawText": "2. create_dataset_splits() quality gate"}, {"id": "m50-gate-body", "type": "text", "x": 745, "y": 600, "width": 530, "height": 125, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500012, "version": 1, "versionNonce": 501012, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c0b", "hasTextLink": true, "text": "Resolve path -> decode image -> preprocess.\nThe setting skip_missing applies ONLY to\na path that does not exist.\n\nEvery row enters exactly one bucket below.", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Resolve path -> decode image -> preprocess.\nThe setting skip_missing applies ONLY to\na path that does not exist.\n\nEvery row enters exactly one bucket below.", "lineHeight": 1.25, "autoResize": false, "rawText": "Resolve path -> decode image -> preprocess.\nThe setting skip_missing applies ONLY to\na path that does not exist.\n\nEvery row enters exactly one bucket below."}, {"id": "m50-arrow-accepted", "type": "arrow", "x": 800, "y": 775, "width": -430, "height": 125, "angle": 0, "strokeColor": "#2b8a3e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500013, "version": 1, "versionNonce": 501013, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c0c", "points": [[0, 0], [-430, 125]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "m50-arrow-skipped", "type": "arrow", "x": 1010, "y": 775, "width": 0, "height": 125, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500014, "version": 1, "versionNonce": 501014, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c0d", "points": [[0, 0], [0, 125]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "m50-arrow-rejected", "type": "arrow", "x": 1220, "y": 775, "width": 430, "height": 125, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500015, "version": 1, "versionNonce": 501015, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c0e", "points": [[0, 0], [430, 125]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "m50-accepted", "type": "rectangle", "x": 80, "y": 920, "width": 540, "height": 260, "angle": 0, "strokeColor": "#2b8a3e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500016, "version": 1, "versionNonce": 501016, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c0f", "roundness": {"type": 3}}, {"id": "m50-accepted-text", "type": "text", "x": 105, "y": 945, "width": 490, "height": 210, "angle": 0, "strokeColor": "#2b8a3e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500017, "version": 1, "versionNonce": 501017, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c0g", "hasTextLink": false, "text": "ACCEPTED\n\nExists + decodes + preprocesses.\nBecomes GalaxyTrainingSample.\nMay enter Dataset / DataLoader / CNN.\n\nObserved fixture totals:\ntrain 2, val 1, test 1", "fontSize": 21, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "ACCEPTED\n\nExists + decodes + preprocesses.\nBecomes GalaxyTrainingSample.\nMay enter Dataset / DataLoader / CNN.\n\nObserved fixture totals:\ntrain 2, val 1, test 1", "lineHeight": 1.25, "autoResize": false, "rawText": "ACCEPTED\n\nExists + decodes + preprocesses.\nBecomes GalaxyTrainingSample.\nMay enter Dataset / DataLoader / CNN.\n\nObserved fixture totals:\ntrain 2, val 1, test 1"}, {"id": "m50-skipped", "type": "rectangle", "x": 740, "y": 920, "width": 540, "height": 260, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "#ffec99", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500018, "version": 1, "versionNonce": 501018, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c0h", "roundness": {"type": 3}}, {"id": "m50-skipped-text", "type": "text", "x": 765, "y": 945, "width": 490, "height": 210, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500019, "version": 1, "versionNonce": 501019, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c0i", "hasTextLink": false, "text": "SKIPPED_MISSING\n\nOnly FileNotFoundError, and only when\nskip_missing=True was chosen.\nThe row + image_id + reason are counted.\n\nTraining may continue, but the report\nshows that the manifest was incomplete.", "fontSize": 21, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "SKIPPED_MISSING\n\nOnly FileNotFoundError, and only when\nskip_missing=True was chosen.\nThe row + image_id + reason are counted.\n\nTraining may continue, but the report\nshows that the manifest was incomplete.", "lineHeight": 1.25, "autoResize": false, "rawText": "SKIPPED_MISSING\n\nOnly FileNotFoundError, and only when\nskip_missing=True was chosen.\nThe row + image_id + reason are counted.\n\nTraining may continue, but the report\nshows that the manifest was incomplete."}, {"id": "m50-rejected", "type": "rectangle", "x": 1400, "y": 920, "width": 540, "height": 260, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500020, "version": 1, "versionNonce": 501020, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c0j", "roundness": {"type": 3}}, {"id": "m50-rejected-text", "type": "text", "x": 1425, "y": 945, "width": 490, "height": 210, "angle": 0, "strokeColor": "#c92a2a", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500021, "version": 1, "versionNonce": 501021, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c0k", "hasTextLink": true, "text": "REJECTED -> STOP\n\nCorrupt or unsupported existing file,\ninvalid pixels/preprocessing, or a\nmissing file in strict mode.\n\nGalaxyDatasetQualityError retains\nall counts and row-specific reasons.", "fontSize": 21, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "REJECTED -> STOP\n\nCorrupt or unsupported existing file,\ninvalid pixels/preprocessing, or a\nmissing file in strict mode.\n\nGalaxyDatasetQualityError retains\nall counts and row-specific reasons.", "lineHeight": 1.25, "autoResize": false, "rawText": "REJECTED -> STOP\n\nCorrupt or unsupported existing file,\ninvalid pixels/preprocessing, or a\nmissing file in strict mode.\n\nGalaxyDatasetQualityError retains\nall counts and row-specific reasons."}, {"id": "m50-footer", "type": "text", "x": 80, "y": 1240, "width": 1340, "height": 75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 500022, "version": 1, "versionNonce": 501022, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "c0l", "hasTextLink": true, "text": "Observed commands and tests\nM51 changes WHEN accepted images decode (lazy __getitem__), not these quality meanings.\nCNN forward/backward/SGD/checkpoint behavior did not change in M50.", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Observed commands and tests\nM51 changes WHEN accepted images decode (lazy __getitem__), not these quality meanings.\nCNN forward/backward/SGD/checkpoint behavior did not change in M50.", "lineHeight": 1.25, "autoResize": false, "rawText": "Observed commands and tests\nM51 changes WHEN accepted images decode (lazy __getitem__), not these quality meanings.\nCNN forward/backward/SGD/checkpoint behavior did not change in M50."}], "appState": {"viewBackgroundColor": "#ffffff"}, "files": {}}