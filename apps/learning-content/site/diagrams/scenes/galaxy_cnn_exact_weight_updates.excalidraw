 our CNN"}, {"id": "activation-extra-014", "type": "text", "x": 1350, "y": 5980, "width": 590, "height": 25.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 620269, "version": 2, "versionNonce": 630269, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b4L", "hasTextLink": true, "text": "Concept: sigmoid, used in the video", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Concept: sigmoid, used in the video", "lineHeight": 1.25, "autoResize": false, "rawText": "Concept: sigmoid, used in the video"}, {"id": "activation-extra-015", "type": "text", "x": 60, "y": 6050, "width": 1880, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 620270, "version": 2, "versionNonce": 630270, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b4M", "hasTextLink": false, "text": "Average over 9 positions: actual ReLU -> a[0] = 0.020664; hypothetical sigmoid -> 0.485872. Different features feed later scores.", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Average over 9 positions: actual ReLU -> a[0] = 0.020664; hypothetical sigmoid -> 0.485872. Different features feed later scores.", "lineHeight": 1.25, "autoResize": false, "rawText": "Average over 9 positions: actual ReLU -> a[0] = 0.020664; hypothetical sigmoid -> 0.485872. Different features feed later scores."}, {"id": "activation-extra-016", "type": "text", "x": 60, "y": 6110, "width": 1880, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 620271, "version": 2, "versionNonce": 630271, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b4N", "hasTextLink": false, "text": "Center z = +0.037116: ReLU gives 0.037116; sigmoid gives 0.509278. Neither operation updates weights.", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Center z = +0.037116: ReLU gives 0.037116; sigmoid gives 0.509278. Neither operation updates weights.", "lineHeight": 1.25, "autoResize": false, "rawText": "Center z = +0.037116: ReLU gives 0.037116; sigmoid gives 0.509278. Neither operation updates weights."}, {"id": "activation-extra-017", "type": "text", "x": 60, "y": 6170, "width": 1880, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 620272, "version": 2, "versionNonce": 630272, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b4O", "hasTextLink": false, "text": "Backward, actual ReLU: incoming gradient 0.014745 passes at the positive center; the negative top-left position blocks it.", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Backward, actual ReLU: incoming gradient 0.014745 passes at the positive center; the negative top-left position blocks it.", "lineHeight": 1.25, "autoResize": false, "rawText": "Backward, actual ReLU: incoming gradient 0.014745 passes at the positive center; the negative top-left position blocks it."}, {"id": "activation-extra-018", "type": "text", "x": 60, "y": 6230, "width": 910, "height": 25.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 620273, "version": 2, "versionNonce": 630273, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b4P", "hasTextLink": true, "text": "Concept: how activation affects backward", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Concept: how activation affects backward", "lineHeight": 1.25, "autoResize": false, "rawText": "Concept: how activation affects backward"}, {"id": "activation-extra-019", "type": "text", "x": 1060, "y": 6230, "width": 870, "height": 25.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 620274, "version": 2, "versionNonce": 630274, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b4Q", "hasTextLink": true, "text": "Concept: sigmoid is not four-class softmax", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Concept: sigmoid is not four-class softmax", "lineHeight": 1.25, "autoResize": false, "rawText": "Concept: sigmoid is not four-class softmax"}, {"id": "activation-extra-020", "type": "text", "x": 60, "y": 6290, "width": 1880, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 620275, "version": 2, "versionNonce": 630275, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b4R", "hasTextLink": false, "text": "A sigmoid activation is not automatically a class probability. Our final Linear outputs logits; softmax is only for reported probabilities.", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A sigmoid activation is not automatically a class probability. Our final Linear outputs logits; softmax is only for reported probabilities.", "lineHeight": 1.25, "autoResize": false, "rawText": "A sigmoid activation is not automatically a class probability. Our final Linear outputs logits; softmax is only for reported probabilities."}, {"id": "activation-extra-021", "type": "text", "x": 60, "y": 6350, "width": 1100, "height": 25.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 620276, "version": 2, "versionNonce": 630276, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b4S", "hasTextLink": true, "text": "Concept: all calculations on our saved input", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Concept: all calculations on our saved input", "lineHeight": 1.25, "autoResize": false, "rawText": "Concept: all calculations on our saved input"}, {"id": "reading-guide-000", "type": "text", "x": 60, "y": 210, "width": 1880, "height": 37.5, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 720277, "version": 1, "versionNonce": 710277, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b4T", "hasTextLink": false, "text": "Read first: PIXELS -> FEATURE MAPS -> POOLED FEATURES -> CLASS SCORES", "fontSize": 30, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Read first: PIXELS -> FEATURE MAPS -> POOLED FEATURES -> CLASS SCORES", "lineHeight": 1.25, "autoResize": false, "rawText": "Read first: PIXELS -> FEATURE MAPS -> POOLED FEATURES -> CLASS SCORES"}, {"id": "reading-guide-001", "type": "text", "x": 60, "y": 260, "width": 1880, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 720278, "version": 1, "versionNonce": 710278, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b4U", "hasTextLink": false, "text": "a[0] means feature zero, not phase zero or class zero. W is weights, not probabilities. The final output is FOUR numbers.", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "a[0] means feature zero, not phase zero or class zero. W is weights, not probabilities. The final output is FOUR numbers.", "lineHeight": 1.25, "autoResize": false, "rawText": "a[0] means feature zero, not phase zero or class zero. W is weights, not probabilities. The final output is FOUR numbers."}, {"id": "reading-guide-002", "type": "text", "x": 60, "y": 330, "width": 1880, "height": 33.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 720279, "version": 1, "versionNonce": 710279, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b4V", "hasTextLink": false, "text": "A. One input image, examined by four filters", "fontSize": 27, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "A. One input image, examined by four filters", "lineHeight": 1.25, "autoResize": false, "rawText": "A. One input image, examined by four filters"}, {"id": "reading-guide-003", "type": "rectangle", "x": 60, "y": 385, "width": 60, "height": 60, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#000000", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "seed": 720280, "version": 1, "versionNonce": 710280, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b4W", "roundness": null, "hasTextLink": false, "containerId": null}, {"id": "reading-guide-004", "type": "rectangle", "x": 124, "y": 385, "width": 60, "height": 60, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#404040", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "seed": 720281, "version": 1, "versionNonce": 710281, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b4X", "roundness": null, "hasTextLink": false, "containerId": null}, {"id": "reading-guide-005", "type": "rectangle", "x": 188, "y": 385, "width": 60, "height": 60, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffffff", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "seed": 720282, "version": 1, "versionNonce": 710282, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b4Y", "roundness": null, "hasTextLink": false, "containerId": null}, {"id": "reading-guide-006", "type": "rectangle", "x": 60, "y": 449, "width": 60, "height": 60, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#202060", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "seed": 720283, "version": 1, "ver