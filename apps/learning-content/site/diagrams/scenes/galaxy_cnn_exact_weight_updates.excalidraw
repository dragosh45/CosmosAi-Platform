se, "index": "b57", "hasTextLink": false, "text": "Feature 3: a[3] = 0.089762", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Feature 3: a[3] = 0.089762", "lineHeight": 1.25, "autoResize": false, "rawText": "Feature 3: a[3] = 0.089762"}, {"id": "reading-guide-041", "type": "text", "x": 60, "y": 1030, "width": 1880, "height": 25.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 720318, "version": 1, "versionNonce": 710318, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b58", "hasTextLink": true, "text": "Concept: pooling makes four internal signals, NOT four classes", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Concept: pooling makes four internal signals, NOT four classes", "lineHeight": 1.25, "autoResize": false, "rawText": "Concept: pooling makes four internal signals, NOT four classes"}, {"id": "reading-guide-042", "type": "text", "x": 60, "y": 1100, "width": 1880, "height": 33.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 720319, "version": 1, "versionNonce": 710319, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b59", "hasTextLink": false, "text": "C. Each class receives ALL FOUR features through its own row of weights", "fontSize": 27, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "C. Each class receives ALL FOUR features through its own row of weights", "lineHeight": 1.25, "autoResize": false, "rawText": "C. Each class receives ALL FOUR features through its own row of weights"}, {"id": "reading-guide-043", "type": "text", "x": 60, "y": 1145, "width": 1880, "height": 26.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 720320, "version": 1, "versionNonce": 710320, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b5A", "hasTextLink": false, "text": "4 outputs x 4 features = 16 learned weights. Multiply each row by the four features above, then add that class bias.", "fontSize": 21, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "4 outputs x 4 features = 16 learned weights. Multiply each row by the four features above, then add that class bias.", "lineHeight": 1.25, "autoResize": false, "rawText": "4 outputs x 4 features = 16 learned weights. Multiply each row by the four features above, then add that class bias."}, {"id": "reading-guide-044", "type": "text", "x": 60, "y": 1200, "width": 180, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 720321, "version": 1, "versionNonce": 710321, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b5B", "hasTextLink": false, "text": "CLASS / ROW i", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "CLASS / ROW i", "lineHeight": 1.25, "autoResize": false, "rawText": "CLASS / ROW i"}, {"id": "reading-guide-045", "type": "text", "x": 245, "y": 1200, "width": 140, "height": 22.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "st