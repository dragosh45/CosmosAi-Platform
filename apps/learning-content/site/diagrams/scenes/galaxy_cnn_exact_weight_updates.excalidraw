1090, "height": 55.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510082, "version": 3, "versionNonce": 520082, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b1K", "hasTextLink": false, "text": "For each W[i,j]: average (P(class i) - target) * feature j\nOne derivative per connection, NOT one global weight update.", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "For each W[i,j]: average (P(class i) - target) * feature j\nOne derivative per connection, NOT one global weight update.", "lineHeight": 1.25, "autoResize": false, "rawText": "For each W[i,j]: average (P(class i) - target) * feature j\nOne derivative per connection, NOT one global weight update."}, {"id": "exact-weight-0083", "type": "text", "x": 60, "y": 3550, "width": 1860, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510083, "version": 2, "versionNonce": 520083, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b1L", "hasTextLink": false, "text": "Confirmed by snapshot: weights BEFORE backward == weights AFTER backward. Only .grad received the new derivatives.", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Confirmed by snapshot: weights BEFORE backward == weights AFTER backward. Only .grad received the new derivatives.", "lineHeight": 1.25, "autoResize": false, "rawText": "Confirmed by snapshot: weights BEFORE backward == weights AFTER backward. Only .grad received the new derivatives."}, {"id": "exact-weight-0084", "type": "text", "x": 60, "y": 3595, "width": 850, "height": 25.0, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510084, "version": 2, "versionNonce": 520084, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b1M", "hasTextLink": true, "text": "Code: before_step() reads the actual .grad tensors", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Code: before_step() reads the actual .grad tensors", "lineHeight": 1.25, "autoResize": false, "rawText": "Code: before_step() reads the actual .grad tensors"}, {"id": "exact-weight-0085", "type": "text", "x": 1000, "y": 3595, "width": 900, "height": 25.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510085, "version": 2, "versionNonce": 520085, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b1N", "hasTextLink": true, "text": "Concept: where these gradients come from", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Concept: where these gradients come from", "lineHeight": 1.25, "autoResize": false, "rawText": "Concept: where these gradients come from"}, {"id": "exact-weight-0086", "type": "text", "x": 60, "y": 3680, "width": 1880, "height": 40.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510086, "version": 2, "versionNonce": 520086, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b1O", "hasTextLink": false, "text": "4. Optimizer: the same matrix changes twice", "fontSize": 32, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "4. Optimizer: the same matrix changes twice", "lineHeight": 1.25, "autoResize": false, "rawText": "4. Optimizer: the same matrix changes twice"}, {"id": "exact-weight-0087", "type": "text", "x": 60, "y": 3729, "width": 1880, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510087, "version": 2, "versionNonce": 520087, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b1P", "hasTextLink": false, "text": "new_weight = old_weight - 0.1 * gradient. Each weight has its own gradient; biases and convolution filters update too.", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "new_weight = old_weight - 0.1 * gradient. Each weight has its own gradient; biases and convolution filters update too.", "lineHeight": 1.25, "autoResize": false, "rawText": "new_weight = old_weight - 0.1 * gradient. Each weight has its own gradient; biases and convolution filters update too."}, {"id": "exact-weight-0088", "type": "text", "x": 60, "y": 3785, "width": 570, "height": 28.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510088, "version": 2, "versionNonce": 520088, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b1Q", "hasTextLink": false, "text": "W0: before update 1", "fontSize": 23, "fontFamily": 1, "textAlign": "left", "vert