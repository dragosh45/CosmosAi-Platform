"solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 720290, "version": 1, "versionNonce": 710290, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b4g", "hasTextLink": false, "text": "Center pixel (180,180,220) -> divide by 255 -> (0.705882,0.705882,0.862745). These are INPUT values.", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Center pixel (180,180,220) -> divide by 255 -> (0.705882,0.705882,0.862745). These are INPUT values.", "lineHeight": 1.25, "autoResize": false, "rawText": "Center pixel (180,180,220) -> divide by 255 -> (0.705882,0.705882,0.862745). These are INPUT values."}, {"id": "reading-guide-014", "type": "text", "x": 310, "y": 480, "width": 1550, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 720291, "version": 1, "versionNonce": 710291, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b4h", "hasTextLink": false, "text": "The manifest labels this artificial fixture \"spiral\". That label is the target, not a property of the square colors.", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The manifest labels this artificial fixture \"spiral\". That label is the target, not a property of the square colors.", "lineHeight": 1.25, "autoResize": false, "rawText": "The manifest labels this artificial fixture \"spiral\". That label is the target, not a property of the square colors."}, {"id": "reading-guide-015", "type": "text", "x": 310, "y": 530, "width": 1550, "height": 27.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 720292, "version": 1, "versionNonce": 710292, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b4i", "hasTextLink": false, "text": "Each filter uses three 3x3 weight slices: red + green + blue. 27 products plus ONE bias make each response.", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Each filter uses three 3x3 weight slices: red + green + blue. 27 products plus ONE bias make each response.", "lineHeight": 1.25, "autoResize": false, "rawText": "Each filter uses three 3x3 weight slices: red + green + blue. 27 products plus ONE bias make each response."}, {"id": "reading-guide-016", "type": "text", "x": 310, "y": 580, "width": 760, "height": 25.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 720293, "version": 1, "versionNonce": 710293, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "b4j", "hasTextLink": true, "text": "Concept: what the colored squares mean", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Concept: what the colored squares mean", "lineHeight": 1.25, "autoResize": false, "rawText": "Concept: what the colored squares mean"}, {"id": "reading-guide-017", "type": "text", "x": 1120, "y": 580, "width": 800, "height": 25.0, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 720294, "version": 1, "versionNonce": 710294, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked"