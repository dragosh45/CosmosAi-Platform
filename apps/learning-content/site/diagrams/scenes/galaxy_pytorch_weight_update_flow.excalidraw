e, "rawText": ""}, {"id": "arrow-3", "type": "arrow", "x": 1075, "y": 275, "width": 80, "height": 0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 34012, "version": 1, "versionNonce": 3401212, "isDeleted": false, "boundElements": null, "updated": 1785600000000, "link": null, "locked": false, "index": "a11", "points": [[0, 0], [80, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "elbowed": false, "roundness": {"type": 2}}, {"id": "box-loss", "type": "rectangle", "x": 1170, "y": 195, "width": 280, "height": 165, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 34013, "version": 1, "versionNonce": 3401313, "isDeleted": false, "boundElements": [], "updated": 1785600000000, "link": null, "locked": false, "index": "a12", "roundness": {"type": 3}}, {"id": "txt-loss", "type": "text", "x": 1190, "y": 215, "width": 240, "height": 120, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 34014, "version": 1, "versionNonce": 3401414, "isDeleted": false, "boundElements": [], "updated": 1785600000000, "link": null, "locked": false, "index": "a13", "hasTextLink": false, "text": "CrossEntropyLoss\n\nUses logits + true label_id\ntrue label_id = 1 = spiral\n\nloss_before = 1.2211\n\nMeaning: prediction is not\nconfident enough on spiral.", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "CrossEntropyLoss\n\nUses logits + true label_id\ntrue label_id = 1 = spiral\n\nloss_before 