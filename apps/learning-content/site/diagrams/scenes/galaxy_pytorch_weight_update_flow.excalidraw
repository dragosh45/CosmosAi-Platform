autoResize": true, "rawText": ""}, {"id": "box-compare", "type": "rectangle", "x": 55, "y": 485, "width": 520, "height": 220, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 34025, "version": 1, "versionNonce": 3402525, "isDeleted": false, "boundElements": [], "updated": 1785600000000, "link": null, "locked": false, "index": "a24", "roundness": {"type": 3}}, {"id": "txt-compare", "type": "text", "x": 80, "y": 510, "width": 470, "height": 170, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 34026, "version": 1, "versionNonce": 3402626, "isDeleted": false, "boundElements": [], "updated": 1785600000000, "link": null, "locked": false, "index": "a25", "hasTextLink": false, "text": "run_torch_training_step()\n\n1. clones classifier.weight before training\n2. forward pass gives logits\n3. loss compares logits to label_id = 1\n4. backward calculates gradients\n5. optimizer.step changes weights\n6. compares old weight to new weight\n\nResult object: TorchTrainingStepResult", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "run_torch_training_step()\n\n1. clones classifier.weight before training\n2. forward pass gives logits\n3. loss compares logits to label_id = 1\n4. backward calculates gradients\n5. optimizer.step changes weights\n6. compares old weight to new weight\n\nResult object: TorchTrainingStepResult", "lineHeight": 1.25, "autoResize": true, "rawText": ""}, {"id": "box-links", "type": "rectangle", "x": 630, "y": 485, "width": 520, "height": 220, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#edf2ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 34027, "version": 1, "versionNonce": 3402727, "isDeleted": false, "boundElements": [], "updated": 1785600000000, "link": null, "locked": false, "index": "a26", "roundness": {"type": 3}}, {"id": "txt-links", "type": "text", "x": 655, "y": 510, "width": 470, "height": 170, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 34028, "version": 1, "versionNonce": 3402828, "isDeleted": false, "boundElements": [], "updated": 1785600000000, "link": null, "locked": false, "index": "a27", "hasTextLink": false, "text": "Concept notes\n\nPyTorch Training Step Proof\nGradient\nBackpropagation\nOptimizer step\nCurrent Tiny Training Result\n\nMain idea: the one image and known label\nchanged model weights once.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Concept notes\n\nPyTorch Training Step Proof\nGradient\nBackpropagation\nOptimizer step\nCurrent Tiny Training Result\n\nMain idea: the one image and known label\nchanged model weights once.", "lineHeight": 1.25, "autoResize": true, "rawText": ""}, {"id": "box-warning", "type": "rectangle", "x": 1205, "y": 485, "width": 520, "height": 220, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff9db", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 34029, "version": 1, "versionNonce": 3402929, "isDeleted": false, "boundElements": [], "updated": 1785600000000, "link": null, "locked": false, "index": "a28", "roundness": {"type": 3}}, {"id": "txt-warning", "type": "text", "x": 1230, "y": 510, "width": 470, "height": 170, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 34030, "version": 1, "versionNonce": 3403030, "isDeleted": false, "boundElements": [], "updated": 1785600000000, "link": null, "locked": false, "index": "a29", "hasTextLink": false, "text": "Boundary\n\nThis is real learning mechanics.\n\nIt is NOT real accuracy yet:\n- one tiny artificial image\n- one optimizer step\n- no validation metric\n- no checkpoint\n- not served by API yet", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Boundary\n\nThis is real learning mechanics.\n\nIt is NOT real accuracy yet:\n- one tiny artificial image\n- one optimizer step\n- no validation metric\n- no checkpoint\n- not served by API yet", "lineHeight": 1.25, "autoResize": true, "rawText": ""}], "appState": {"viewBackgroundColor": "#ffffff"}, "files": {}}