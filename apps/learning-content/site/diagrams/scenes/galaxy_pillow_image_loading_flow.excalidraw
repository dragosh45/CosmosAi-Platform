{"type": "excalidraw", "version": 2, "source": "CosmosAI learning export", "elements": [{"id": "title", "type": "text", "x": 60, "y": 40, "width": 980, "height": 40, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 46000001, "version": 1, "versionNonce": 460000011, "isDeleted": false, "boundElements": [], "updated": 1787060000000, "link": null, "locked": false, "index": "a1", "hasTextLink": false, "text": "Milestone 46: Pillow Real-Image Loading Proof", "fontSize": 32, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Milestone 46: Pillow Real-Image Loading Proof", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "subtitle", "type": "text", "x": 60, "y": 92, "width": 1450, "height": 24, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 46000002, "version": 1, "versionNonce": 460000021, "isDeleted": false, "boundElements": [], "updated": 1787060000000, "link": "/learn/concepts/#concept-pillow-image-loading", "locked": false, "index": "a2", "hasTextLink": true, "text": "Click boxes for VS Code code links. Click this subtitle for the Obsidian concept note.", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Click boxes for VS Code code links. Click this subtitle for the Obsidian concept note.", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "manifest-box", "type": "rectangle", "x": 60, "y": 190, "width": 350, "height": 165, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 46000003, "version": 1, "versionNonce": 460000031, "isDeleted": false, "boundElements": [], "updated": 1787060000000, "link": null, "locked": false, "index": "a3", "roundness": {"type": 3}}, {"id": "manifest-text", "type": "text", "x": 82, "y": 215, "width": 300, "height": 110, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 46000004, "version": 1, "versionNonce": 460000041, "isDeleted": false, "boundElements": [], "updated": 1787060000000, "link": null, "locked": false, "index": "a4", "hasTextLink": false, "text": "GalaxyManifestRecord\nimage_path can now point to:\n.ppm for tiny text proof\n.png/.jpg/.jpeg for real images", "fontSize": 17, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "GalaxyManifestRecord\nimage_path can now point to:\n.ppm for tiny text proof\n.png/.jpg/.jpeg for real images", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "dispatch-box", "type": "rectangle", "x": 520, "y": 190, "width": 360, "height": 165, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#d0ebff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 46000005, "version": 1, "versionNonce": 460000051, "isDeleted": false, "boundElements": [], "updated": 1787060000000, "link": null, "locked": false, "index": "a5", "roundness": {"type": 3}}, {"id": "dispatch-text", "type": "text", "x": 542, "y": 215, "width": 310, "height": 110, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 46000006, "version": 1, "versionNonce": 460000061, "isDeleted": false, "boundElements": [], "updated": 1787060000000, "link": null, "locked": false, "index": "a6", "hasTextLink": false, "text": "load_image_file()\nLooks at file extension.\n.ppm -> text parser\n.png/.jpg -> Pillow loader\nunsupported -> clear error", "fontSize": 17, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "load_image_file()\nLooks at file extension.\n.ppm -> text parser\n.png/.jpg -> Pillow loader\nunsupported -> clear error", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "pillow-box", "type": "rectangle", "x": 990, "y": 190, "width": 390, "height": 165, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 46000007, "version": 1, "versionNonce": 460000071, "isDeleted": false, "boundElements": [], "updated": 1787060000000, "link": null, "locked": false, "index": "a7", "roundness": {"type": 3}}, {"id": "pillow-text", "type": "text", "x": 1012, "y": 215, "width": 335, "height": 115, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 46000008, "version": 1, "versionNonce": 460000081, "isDeleted": false, "boundElements": [], "updated": 1787060000000, "link": null, "locked": false, "index": "a8", "hasTextLink": false, "text": "load_pillow_image()\nImage.open(...)\nconvert(\"RGB\") -> 3 channels\noptional resize(width, height)\nflatten pixels as RGB RGB RGB", "fontSize": 17, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "load_pillow_image()\nImage.open(...)\nconvert(\"RGB\") -> 3 channels\noptional resize(width, height)\nflatten pixels as RGB RGB RGB", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "preprocess-box", "type": "rectangle", "x": 1490, "y": 190, "width": 380, "height": 165, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 46000009, "version": 1, "versionNonce": 460000091, "isDeleted": false, "boundElements": [], "updated": 1787060000000, "link": null, "locked": false, "index": "a9", "roundness": {"type": 3}}, {"id": "preprocess-text", "type": "text", "x": 1512, "y": 215, "width": 325, "height": 115, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 46000010, "version": 1, "versionNonce": 460000101, "isDeleted": false, "boundElements": [], "updated": 1787060000000, "link": null, "locked": false, "index": "a10", "hasTextLink": false, "text": "load_and_preprocess_image_for_record()\nKeeps same pipeline.\nLoaded pixels -> preprocess_image()\n0-255 ints -> 0.0-1.0 floats", "fontSize": 17, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "load_and_preprocess_image_for_record()\nKeeps same pipeline.\nLoaded pixels -> preprocess_image()\n0-255 ints -> 0.0-1.0 floats", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "shape-box", "type": "rectangle", "x": 60, "y": 455, "width": 560, "height": 220, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 46000011, "version": 1, "versionNonce": 460000111, "isDeleted": false, "boundElements": [], "updated": 1787060000000, "link": "/learn/concepts/#concept-pillow-image-loading", "locked": false, "index": "a11", "roundness": {"type": 3}}, {"id": "shape-text", "type": "text", "x": 88, "y": 485, "width": 500, "height": 155, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 46000012, "version": 1, "versionNonce": 460000121, "isDeleted": false, "boundElements": [], "updated": 1787060000000, "link": "/learn/concepts/#concept-pillow-image-loading", "locked": false, "index": "a12", "hasTextLink": true, "text": "Shape example\n\nOriginal PNG: width=2, height=1\nTarget size: (3, 3) = width, height\nGalaxyImage: width=3, height=3, channels=3\nGalaxyImageTensor: shape=(3, 3, 3)\nPyTorch later: shape=(1, 3, 3, 3)", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Shape example\n\nOriginal PNG: width=2, height=1\nTarget size: (3, 3) = width, height\nGalaxyImage: width=3, height=3, channels=3\nGalaxyImageTensor: shape=(3, 3, 3)\nPyTorch later: shape=(1, 3, 3, 3)", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "cli-box", "type": "rectangle", "x": 760, "y": 455, "width": 520, "height": 220, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 46000013, "version": 1, "versionNonce": 460000131, "isDeleted": false, "boundElements": [], "updated": 1787060000000, "link": null, "locked": false, "index": "a13", "roundness": {"type": 3}}, {"id": "cli-text", "type": "text", "x": 788, "y": 485, "width": 465, "height": 155, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 46000014, "version": 1, "versionNonce": 460000141, "isDeleted": false, "boundElements": [], "updated": 1787060000000, "link": null, "locked": false, "index": "a14", "hasTextLink": false, "text": "target_size_from_args()\n\nCLI can pass:\n--image-width 224\n--image-height 224\n\nBoth are required together.\nPillow uses (width, height).", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "target_size_from_args()\n\nCLI can pass:\n--image-width 224\n--image-height 224\n\nBoth are required together.\nPillow uses (width, height).", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "why-box", "type": "rectangle", "x": 1420, "y": 455, "width": 450, "height": 220, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 46000015, "version": 1, "versionNonce": 460000151, "isDeleted": false, "boundElements": [], "updated": 1787060000000, "link": "/learn/concepts/#concept-pillow-image-loading", "locked": false, "index": "a15", "roundness": {"type": 3}}, {"id": "why-text", "type": "text", "x": 1448, "y": 485, "width": 390, "height": 155, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 46000016, "version": 1, "versionNonce": 460000161, "isDeleted": false, "boundElements": [], "updated": 1787060000000, "link": "/learn/concepts/#concept-pillow-image-loading", "locked": false, "index": "a16", "hasTextLink": true, "text": "Why now?\n\nReal datasets use PNG/JPG.\nReal batches need same-size images.\nThis proves the input path before\nlarge data download or GPU training.", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Why now?\n\nReal datasets use PNG/JPG.\nReal batches need same-size images.\nThis proves the input path before\nlarge data download or GPU training.", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "arrow-manifest-dispatch", "type": "arrow", "x": 430, "y": 272, "width": 70, "height": 0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 46000017, "version": 1, "versionNonce": 460000171, "isDeleted": false, "boundElements": [], "updated": 1787060000000, "link": null, "locked": false, "index": "a17", "points": [[0, 0], [70, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "arrow-dispatch-pillow", "type": "arrow", "x": 900, "y": 272, "width": 70, "height": 0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 46000018, "version": 1, "versionNonce": 460000181, "isDeleted": false, "boundElements": [], "updated": 1787060000000, "link": null, "locked": false, "index": "a18", "points": [[0, 0], [70, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "arrow-pillow-preprocess", "type": "arrow", "x": 1400, "y": 272, "width": 70, "height": 0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 46000019, "version": 1, "versionNonce": 460000191, "isDeleted": false, "boundElements": [], "updated": 1787060000000, "link": null, "locked": false, "index": "a19", "points": [[0, 0], [70, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}], "appState": {"viewBackgroundColor": "#ffffff"}, "files": {}}