, "seed": 48000010, "version": 1, "versionNonce": 48000110, "isDeleted": false, "boundElements": [], "updated": 1788912000000, "link": null, "locked": false, "index": "b0A", "hasTextLink": false, "text": "Four artificial RGB 3x3 fixtures:\ntrain = 2, validation = 1, test = 1.\nKingston adds disk space, not RAM.\nM51 Dataset reads files on demand.", "fontSize": 21, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Four artificial RGB 3x3 fixtures:\ntrain = 2, validation = 1, test = 1.\nKingston adds disk space, not RAM.\nM51 Dataset reads files on demand.", "lineHeight": 1.25, "autoResize": false, "rawText": "Four artificial RGB 3x3 fixtures:\ntrain = 2, validation = 1, test = 1.\nKingston adds disk space, not RAM.\nM51 Dataset reads files on demand."}, {"id": "m48-011", "type": "text", "x": 854, "y": 392, "width": 548, "height": 23.75, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000011, "version": 1, "versionNonce": 48000111, "isDeleted": false, "boundElements": [], "updated": 1788912000000, "link": null, "locked": false, "index": "b0B", "hasTextLink": true, "text": "Concept: disk versus RAM", "fontSize": 19, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Concept: disk versus RAM", "lineHeight": 1.25, "autoResize": false, "rawText": "Concept: disk versus RAM"}, {"id": "m48-012", "type": "arrow", "x": 390, "y": 435, "width": 0, "height": 60, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000012, "version": 1, "versionNonce": 48000112, "isDeleted": false, "boundElements": [], "updated": 1788912000000, "link": null, "locked": false, "index": "