{"type": "excalidraw", "version": 2, "source": "CosmosAI learning export", "elements": [{"id": "m48-000", "type": "text", "x": 90, "y": 40, "width": 1380, "height": 40.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000000, "version": 1, "versionNonce": 48000100, "isDeleted": false, "boundElements": [], "updated": 1788912000000, "link": null, "locked": false, "index": "b00", "hasTextLink": false, "text": "Milestone 48: DataLoader feeds real CNN training", "fontSize": 32, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Milestone 48: DataLoader feeds real CNN training", "lineHeight": 1.25, "autoResize": false, "rawText": "Milestone 48: DataLoader feeds real CNN training"}, {"id": "m48-001", "type": "text", "x": 90, "y": 92, "width": 1380, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000001, "version": 1, "versionNonce": 48000101, "isDeleted": false, "boundElements": [], "updated": 1788912000000, "link": null, "locked": false, "index": "b01", "hasTextLink": false, "text": "Blue function labels open VS Code. Purple concept labels open Obsidian.", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Blue function labels open VS Code. Purple concept labels open Obsidian.", "lineHeight": 1.25, "autoResize": false, "rawText": "Blue function labels open VS Code. Purple concept labels open Obsidian."}, {"id": "m48-002", "type": "text", "x": 90, "y": 126, "width": 1380, "height": 25.0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000002, "version": 1, "versionNonce": 48000102, "isDeleted": false, "boundElements": [], "updated": 1788912000000, "link": null, "locked": false, "index": "b02", "hasTextLink": false, "text": "One model + optimizer survive all epochs. Only train data change the weights.", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "One model + optimizer survive all epochs. Only train data change the weights.", "lineHeight": 1.25, "autoResize": false, "rawText": "One model + optimizer survive all epochs. Only train data change the weights."}, {"id": "m48-003", "type": "rectangle", "x": 90, "y": 190, "width": 600, "height": 240, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000003, "version": 1, "versionNonce": 48000103, "isDeleted": false, "boundElements": [], "updated": 1788912000000, "link": null, "locked": false, "index": "b03", "roundness": {"type": 3}, "hasTextLink": false}, {"id": "m48-004", "type": "text", "x": 114, "y": 210, "width": 548, "height": 28.75, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000004, "version": 1, "versionNonce": 48000104, "isDeleted": false, "boundElements": [], "updated": 1788912000000, "link": null, "locked": false, "index": "b04", "hasTextLink": true, "text": "1. run_torch_training_loop()", "fontSize": 23, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "1. run_torch_training_loop()", "lineHeight": 1.25, "autoResize": false, "rawText": "1. run_torch_training_loop()"}, {"id": "m48-005", "type": "text", "x": 114, "y": 256, "width": 548, "height": 78.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000005, "version": 1, "versionNonce": 48000105, "isDeleted": false, "boundElements": [], "updated": 1788912000000, "link": null, "locked": false, "index": "b05", "hasTextLink": false, "text": "Reads the train split, builds the loader,\nand keeps one CNN + SGD optimizer.\nManual batching stays a separate demo.", "fontSize": 21, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Reads the train split, builds the loader,\nand keeps one CNN + SGD optimizer.\nManual batching stays a separate demo.", "lineHeight": 1.25, "autoResize": false, "rawText": "Reads the train split, builds the loader,\nand keeps one CNN + SGD optimizer.\nManual batching stays a separate demo."}, {"id": "m48-006", "type": "text", "x": 114, "y": 392, "width": 548, "height": 23.75, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000006, "version": 1, "versionNonce": 48000106, "isDeleted": false, "boundElements": [], "updated": 1788912000000, "link": null, "locked": false, "index": "b06", "hasTextLink": true, "text": "Concept: the complete loop", "fontSize": 19, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Concept: the complete loop", "lineHeight": 1.25, "autoResize": false, "rawText": "Concept: the complete loop"}, {"id": "m48-007", "type": "text", "x": 114, "y": 350, "width": 548, "height": 23.75, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 48000007, "