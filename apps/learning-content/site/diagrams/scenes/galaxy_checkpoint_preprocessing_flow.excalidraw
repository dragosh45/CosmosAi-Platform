oughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 490002, "version": 1, "versionNonce": 490102, "isDeleted": false, "boundElements": [], "updated": 1788912000000, "link": null, "locked": false, "index": "b02", "hasTextLink": false, "text": "The training equations stay the same. This fixes how CLI and API prepare pixels.", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The training equations stay the same. This fixes how CLI and API prepare pixels.", "lineHeight": 1.25, "autoResize": false, "rawText": "The training equations stay the same. This fixes how CLI and API prepare pixels."}, {"id": "m49-003", "type": "rectangle", "x": 90, "y": 195, "width": 610, "height": 265, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 490003, "version": 1, "versionNonce": 490103, "isDeleted": false, "boundElements": [], "updated": 1788912000000, "link": null, "locked": false, "index": "b03", "roundness": {"type": 3}, "hasTextLink": false}, {"id": "m49-004", "type": "text", "x": 112, "y": 213, "width": 566, "height": 27.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 490004, "version": 1, "versionNonce": 490104, "isDeleted": false, "boundElements": [], "updated": 1788912000000, "link": null, "locked": false, "index": "b04", "hasTextLink": true, "text": "1. Training main()", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "1. Training main()", "lineHeight": 1.25, "autoResize": false, "rawText": "1. Training main()"}, {"id": "m49-005", "type": "text", "x": 112, "y": 255, "width": 566, "height": 125.0, "angle": 0, "stro