\npreprocessing: GalaxyPreprocessingPolicy\nOne object keeps both together.\nA new CNN alone has no knowledge of resize."}, {"id": "m49-020", "type": "text", "x": 862, "y": 745, "width": 566, "height": 22.5, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 490020, "version": 1, "versionNonce": 490120, "isDeleted": false, "boundElements": [], "updated": 1788912000000, "link": null, "locked": false, "index": "b0K", "hasTextLink": true, "text": "Concept: Checkpoint Preprocessing Contract", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Concept: Checkpoint Preprocessing Contract", "lineHeight": 1.25, "autoResize": false, "rawText": "Concept: Checkpoint Preprocessing Contract"}, {"id": "m49-021", "type": "arrow", "x": 395, "y": 785, "width": 0, "height": 65, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 490021, "version": 1, "versionNonce": 490121, "isDeleted": false, "boundElements": [], "updated": 1788912000000, "link": null, "locked": false, "index": "b0L", "points": [[0, 0], [0, 65]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "hasTextLink": false}, {"id": "m49-022", "type": "text", "x": 419, "y": 797, "width": 560, "height": 21.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 490022, "version": 1, "versionNonce": 490122, "isDeleted": false, "boundElements": [], "updated": 1788912000000, "link": null, "locked": false, "index": "b0M", "hasTextLink"