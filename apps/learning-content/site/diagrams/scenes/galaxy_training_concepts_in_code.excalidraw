autoResize": true, "rawText": "", "roundness": null}, {"id": "1SfmFriD", "type": "rectangle", "x": 435, "y": 200, "width": 320, "height": 245, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ebfbee", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 15006, "version": 3, "versionNonce": 1979775990, "isDeleted": false, "boundElements": [], "updated": 1785485085050, "link": null, "locked": false, "index": "a5", "hasTextLink": false}, {"id": "srnZSYkP", "type": "text", "x": 453, "y": 218, "width": 230.9326171875, "height": 168.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 15007, "version": 3, "versionNonce": 596993642, "isDeleted": false, "boundElements": [], "updated": 1785485085050, "link": null, "locked": false, "index": "a6", "hasTextLink": false, "text": "PlaceholderGalaxyModel.forward()\n\nMeaning:\nfake model calculation.\nIt pretends to be the future CNN.\n\nCurrent behavior:\nhand-written math\nnot learned weights", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "PlaceholderGalaxyModel.forward()\n\nMeaning:\nfake model calculation.\nIt pretends to be the future CNN.\n\nCurrent behavior:\nhand-written math\nnot learned weights", "lineHeight": 1.25, "autoResize": true, "rawText": "", "roundness": null}, {"id": "fNCJpVsr", "type": "rectangle", "x": 815, "y": 200, "width": 320, "height": 245, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#f3f0ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 15008, "version": 3, "versionNonce": 397020470, "isDeleted": false, "boundElements": [], "updated": 1785485085050, "link": null, "locked": false, "index": "a7", "hasTextLink": false}, {"id": "UYtnGo2M", "type": "text", "x": 833, "y": 218, "width": 245.93994140625, "height": 168.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 15009, "version": 3, "versionNonce": 431032618, "isDeleted": false, "boundElements": [], "updated": 1785485085050, "link": null, "locked": false, "index": "a8", "hasTextLink": false, "text": "logits\n\nMeaning:\nraw class scores before probabilities.\nBigger score = more favored class.\n\nCurrent values:\n[0.1995, 0.2247,\n 0.1400, 0.1302]", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "logits\n\nMeaning:\nraw class scores before probabilities.\nBigger score = more favored class.\n\nCurrent values:\n[0.1995, 0.2247,\n 0.1400, 0.1302]", "lineHeight": 1.25, "autoResize": true, "rawText": "", "roundness": null}, {"id": "IOPIMIvr", "type": "rectangle", "x": 1195, "y": 200, "width": 320, "height": 245, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 15010, "version": 3, "versionNonce": 1553921654, "isDeleted": false, "boundElements": [], "updated": 1785485085050, "link": null, "locked": false, "index": "a9", "hasTextLink": false}, {"id": "ScubbQmz", "type": "text", "x": 1213, "y": 218, "width": 217.646484375, "height": 131.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 15011, "version": 3, "versionNonce": 2043302890, "isDeleted": false, "boundElements": [], "updated": 1785485085050, "link": null, "locked": false, "index": "aA", "hasTextLink": false, "text": "softmax()\n\nMeaning:\nturns logits into probabilities.\nAll probabilities add to about 1.0.\n\nCode helper", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "softmax()\n\nMeaning:\nturns logits into probabilities.\nAll probabilities add to about 1.0.\n\nCode helper", "lineHeight": 1.25, "autoResize": true, "rawText": "", "roundness": null}, {"id": "loss-box", "type": "rectangle", "x": 1575, "y": 200, "width": 320, "height": 245, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 15012, "version": 3, "versionNonce": 497334198, "isDeleted": false, "boundElements": [], "updated": 1785485085050, "link": null, "locked": false, "index": "aB", "hasTextLink": false}, {"id": "zjT5pnOh", "type": "text", "x": 1593, "y": 218, "width": 356.02294921875, "height": 150, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 15013, "version": 3, "versionNonce": 99370666, "isDeleted": false, "boundElements": [], "updated": 1785485085050, "link": null, "locked": false, "index": "aC", "hasTextLink": false, "text": "cross_entropy_loss()\n\nMeaning:\nmeasures how much the output missed the true label.\nLower loss is better.\n\nCurrent loss:\n1.3360", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "cross_entropy_loss()\n\nMeaning:\nmeasures how much the output missed the true label.\nLower loss is better.\n\nCurrent loss:\n1.3360", "lineHeight": 1.25, "autoResize": true, "rawText": "", "roundness": null}, {"id": "flow-arrow-1", "type": "ar