, "index": "b02", "hasTextLink": false}, {"id": "feCOjwEN", "type": "text", "x": 488.537499714732, "y": 946.8579728902929, "width": 668.7451171875, "height": 75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 15067, "version": 29, "versionNonce": 827950454, "isDeleted": false, "boundElements": [], "updated": 1785485513872, "link": null, "locked": false, "text": "Class score mapping in the fake formula\nlogit0 -> elliptical, logit1 -> spiral, logit2 -> lenticular, logit3 -> irregular.\nmean_value means average image brightness. shape_value = (height+width+channels)/100.\nThe constants 0.10, 0.20, etc. are placeholder numbers only; they are not learned galaxy knowledge.", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Class score mapping in the fake formula\nlogit0 -> elliptical, logit1 -> spiral, logit2 -> lenticular, logit3 -> irregular.\nmean_value means average image brightness. shape_value = (height+width+channels)/100.\nThe constants 0.10, 0.20, etc. are placeholder numbers only; they are not learned galaxy knowledge.", "lineHeight": 1.25, "autoResize": true, "index": "b03", "hasTextLink": false, "rawText": ""}], "appState": {"viewBackgroundColor": "#ffffff"}, "files": {}}