{"type": "excalidraw", "version": 2, "source": "CosmosAI learning export", "elements": [{"id": "title", "type": "text", "x": 50, "y": 30, "width": 670.8837890625, "height": 37.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 15001, "version": 3, "versionNonce": 1881566762, "isDeleted": false, "boundElements": [], "updated": 1785485085050, "link": null, "locked": false, "index": "a0", "hasTextLink": false, "text": "Training Concept Diagram: Current Code Skeleton", "fontSize": 30, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Training Concept Diagram: Current Code Skeleton", "lineHeight": 1.25, "autoResize": true, "rawText": "", "roundness": null}, {"id": "subtitle", "type": "text", "x": 55, "y": 78, "width": 836.9140625, "height": 20, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 15002, "version": 3, "versionNonce": 1583243638, "isDeleted": false, "boundElements": [], "updated": 1785485085050, "link": null, "locked": false, "index": "a1", "hasTextLink": false, "text": "How train_galaxy_cnn_baseline.py connects code flow to ML concepts. Current model is placeholder, not real training.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "How train_galaxy_cnn_baseline.py connects code flow to ML concepts. Current model is placeholder, not real training.", "lineHeight": 1.25, "autoResize": true, "rawText": "", "roundness": null}, {"id": "My4fjE9l", "type": "text", "x": 55, "y": 130, "width": 294.1640625, "height": 30, "angle": 0, "strokeColor": "#5f3dc4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strok