: "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 45032, "version": 2, "versionNonce": 1167854040, "isDeleted": false, "boundElements": [], "updated": 1788338966931, "link": null, "locked": false, "index": "aW", "points": [[0, 0], [105, 330]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "roundness": {"type": 2}, "elbowed": false, "hasTextLink": false}, {"id": "41ze4ItE", "type": "arrow", "x": 820, "y": 1078, "width": 210, "height": 430, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 45033, "version": 2, "versionNonce": 2036604840, "isDeleted": false, "boundElements": [], "updated": 1788338966931, "link": null, "locked": false, "index": "aX", "points": [[0, 0], [210, 430]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "roundness": {"type": 2}, "elbowed": false, "hasTextLink": false}, {"id": "zioKVjzt", "type": "rectangle", "x": 1030, "y": 950, "width": 540, "height": 320, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 653615, "version": 1, "versionNonce": 902842, "isDeleted": false, "boundElements": [], "updated": 1788342000000, "link": "/learn/concepts/#concept-inside-training-loop", "locked": false, "index": "b14", "roundness": {"type": 3}, "hasTextLink": false}, {"id": "kCeNDrxe", "type": "text", "x": 1050, "y": 970, "width": 520, "height": 300, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 766742, "version": 1, "versionNonce": 335738, "isDeleted": false, "boundElements": [], "updated": 1788342000000, "link": "/learn/concepts/#concept-inside-training-loop", "locked": false, "index": "b15", "hasTextLink": true, "text": "Inside one training loop\nConcept doc: Inside One Training Loop\n\n1. create one active_model\n   same weights survive all epochs\n2. create one optimizer\n   tied to that model's weights\n3. for each epoch\n   one pass over train samples\n4. for each train sample\n   forward -> loss -> backward -> optimizer.step\n5. record losses\n   observe whether training moved\n\nClick this box for the concept doc. Function boxes link directly to\ncode.", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Inside one training loop\nConcept doc: Inside One Training Loop\n\n1. create one active_model\n   same weights survive all epochs\n2. create one optimizer\n   tied to that model's weights\n3. for each epoch\n   one pass over train samples\n4. for each train sample\n   forward -> loss -> backward -> optimizer.step\n5. record losses\n   observe whether training moved\n\nClick this box for the concept doc. Function boxes link directly to code.", "lineHeight": 1.25, "autoResize": false, "rawText": "Inside one training loop\nConcept doc: Inside One Training Loop\n\n1. create one active_model\n   same weights survive all epochs\n2. create one optimizer\n   tied to that model's weights\n3. for each epoch\n   one pass over train samples\n4. for each train sample\n   forward -> loss -> backward -> optimizer.step\n5. record losses\n   observe whether training moved\n\nClick this box for the concept doc. Function boxes link directly to code.", "roundness": null}, {"id": "cv1VSmLy", "type": "rectangle", "x": 1030, "y": 1625, "width": 540, "height": 325, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1018220, "version": 1, "versionNonce": 619188, "isDeleted": false, "boundElements": [], "updated": 1788342000000, "link": "/learn/concepts/#concept-checkpoint-round-trip", "locked": false, "index": "b20", "roundness": {"type": 3}, "hasTextLink": false}, {"id": "IH23MSwR", "type": "text", "x": 1049.1898240562582, "y": 1645, "width": 520, "height": 300, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 203087, "version": 2, "versionNonce": 577636767, "isDeleted": false, "boundElements": [], "updated": 1788342912391, "link": "/learn/concepts/#concept-checkpoint-round-trip", "locked": false, "index": "b21", "hasTextLink": true, "text": "Inside one checkpoint round trip\nConcept doc: Checkpoint Round Trip\n\n1. save_torch_checkpoint()\n   writes trained model.state_dict to disk\n2. load_torch_checkpoint()\n   fresh TinyGalaxyCNN receives saved weights\n3. run_torch_forward_pass(trained_model)\n   prediction before loading\n4. run_torch_forward_pass(loaded_model)\n   prediction after loading\n5. compare logits/probabilities\n   match means saved weights loaded correctly\n\nClick this box for the concept doc. Function boxes link directly to\ncode.", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Inside one checkpoint round trip\nConcept doc: Checkpoint Round Trip\n\n1. save_torch_checkpoint()\n   writes trained model.state_dict to disk\n2. load_torch_checkpoint()\n   fresh TinyGalaxyCNN receives saved weights\n3. run_torch_forward_pass(trained_model)\n   prediction before loading\n4. run_torch_forward_pass(loaded_model)\n   prediction after loading\n5. compare logits/probabilities\n   match means saved weights loaded correctly\n\nClick this box for the concept doc. Function boxes link directly to code.", "lineHeight": 1.25, "autoResize": false, "rawText": "Inside one checkpoint round trip\nConcept doc: Checkpoint Round Trip\n\n1. save_torch_checkpoint()\n   writes trained model.state_dict to disk\n2. load_torch_checkpoint()\n   fresh TinyGalaxyCNN receives saved weights\n3. run_torch_forward_pass(trained_model)\n   prediction before loading\n4. run_torch_forward_pass(loaded_model)\n   prediction after loading\n5. compare logits/probabilities\n   match means saved weights loaded correctly\n\nClick this box for the concept doc. Function boxes link directly to code.", "roundness": null}, {"id": "QjJIltGJ", "type": "arrow", "x": 910, "y": 1010, "width": 105, "height": 60, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 288012, "version": 1, "versionNonce": 819609, "isDeleted": false, "boundElements": [], "updated": 1788342000000, "link": null, "locked": false, "index": "b30", "points": [[0, 0], [105, 60]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "roundness": {"type": 2}, "elbowed": false, "hasTextLink": false}, {"id": "kHesIfpb", "type": "arrow", "x": 1230, "y": 1595, "width": 0, "height": 25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 606363, "version": 1, "versionNonce": 96378, "isDeleted": false, "boundElements": [], "updated": 1788342000000, "link": null, "locked": false, "index": "b31", "points": [[0, 0], [0, 25]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "roundness": {"type": 2}, "elbowed": false, "hasTextLink": false}, {"id": "fj1gaJ4j", "type": "text", "x": 1595, "y": 625, "width": 360, "height": 45, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1217371956, "version": 3, "versionNonce": 660072690, "isDeleted": false, "boundElements": [], "updated": 1788345872527, "link": null, "locked": false, "index": "b32", "hasTextLink": false, "text": "Code:\ngalaxy_tensor_to_torch_image()", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Code: galaxy_tensor_to_torch_image()", "lineHeight": 1.25, "autoResize": false, "rawText": "Code: galaxy_tensor_to_torch_image()", "roundness": null}, {"id": "cfxup3rB", "type": "text", "x": 1595, "y": 660, "width": 360, "height": 22.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1841912287, "version": 3, "versionNonce": 153933614, "isDeleted": false, "boundElements": [], "updated": 1788345872527, "link": null, "locked": false, "index": "b33", "hasTextLink": false, "text": "Code: TinyGalaxyCNN.forward()", "fontSize": 18, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Code: TinyGalaxyCNN.forward()", "lineHeight": 1.25, "autoResize": false, "rawText": "Code: TinyGalaxyCNN.forward()", "roundness": null}, {"id": "oM3M25EN", "type": "text", "x": 1595, "y": 695, "width": 360, "height": 22.5, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 1575279804, "version": 2, "versionNonce": 236059314, "isDeleted": false, "boundElements": [], "updated": 1788345872527, "link": null, "locked": false, "index": "