id": "hHC0o67o", "type": "rectangle", "x": 540, "y": 420, "width": 360, "height": 132, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 45009, "version": 3, "versionNonce": 1805867944, "isDeleted": false, "boundElements": [], "updated": 1788338966931, "link": null, "locked": false, "index": "a9", "roundness": {"type": 3}, "hasTextLink": false}, {"id": "hPU110IM", "type": "text", "x": 560, "y": 440, "width": 320, "height": 80, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 45010, "version": 3, "versionNonce": 395285208, "isDeleted": false, "boundElements": [], "updated": 1788338966931, "link": null, "locked": false, "index": "aA", "hasTextLink": false, "text": "run_torch_forward_pass()\nConcept: inspect only.\nUses current weights to produce\nlogits + probabilities.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "run_torch_forward_pass()\nConcept: inspect only.\nUses current weights to produce\nlogits + probabilities.", "lineHeight": 1.25, "autoResize": false, "rawText": "", "roundness": null}, {"id": "GsmBBf7h", "type": "rectangle", "x": 540, "y": 660, "width": 360, "height": 150, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffec99", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 45011, "version": 2, "versionNonce": 420062888, "isDeleted": false, "boundElements": [], "updated": 1788338966931, "link": null, "locked": false, "index": "aB", "roundness": {"type": 3}, "hasTextLink": false}, {"id": "Rp2i640R", "type": "text", "x": 560, "y": 680, "width": 320, "height": 100, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 45012, "version": 2, "versionNonce": 315062232, "isDeleted": false, "boundElements": [], "updated": 1788338966931, "link": null, "locked": false, "index": "aC", "hasTextLink": false, "text": "run_torch_training_step()\nConcept: one isolated update.\nForward -> loss -> backward\n-> optimizer.step once.\nUses its own demo model.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "run_torch_training_step()\nConcept: one isolated update.\nForward -> loss -> backward\n-> optimizer.step once.\nUses its own demo model.", "lineHeight": 1.25, "autoResize": false, "rawText": "", "roundness": null}, {"id": "loop-bg", "type": "rectangle", "x": 540, "y": 920, "width": 360, "height": 150, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffd8a8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 45013, "version": 2, "versionNonce": 2037289384, "isDeleted": false, "boundElements": [], "updated": 1788338966931, "link": null, "locked": false, "index": "aD", "roundness": {"type": 3}, "hasTextLink": false}, {"id": "3qhKsVSD", "type": "text", "x": 560, "y": 940, "width": 320, "height": 100, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 45014, "version": 2, "versionNonce": 129678552, "isDeleted": false, "boundElements": [], "updated": 1788338966931, "link": null, "locked": false, "index": "aE", "hasTextLink": false, "text": "run_torch_training_loop()\nConcept: repeated training path.\nSame model + optimizer across epochs.\nIts trained loop_model is evaluated\nand checkpointed.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "run_torch_training_loop()\nConcept: repeated training path.\nSame model + optimizer across epochs.\nIts trained loop_model is evaluated\nand checkpointed.", "lineHeight": 1.25, "autoResize": false, "rawText": "", "roundness": null}, {"id": "qbiKeW0D", "type": "rectangle", "x": 1030, "y": 590, "width": 540, "height": 365, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 45015, "version": 2, "versionNonce": 1946033320, "isDeleted": false, "boundElements": [], "updated": 1788338966931, "link": "/learn/concepts/#concept-pytorch-training-step", "locked": false, "index": "aF", "roundness": {"type": 3}, "hasTextLink": false}, {"id": "NIzr41rY", "type": "text", "x": 1050, "y": 610, "width": 520, "height": 300, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 45016, "version": 2, "versionNonce": 1744658904, "isDeleted": false, "boundElements": [], "updated": 1788338966931, "link": "/learn/concepts/#concept-pytorch-training-step", "locked": false, "index": "aG", "hasTextLink": true, "text": "Inside one training update\nConcept doc: PyTorch Training Step Proof\n\n1. galaxy_tensor_to_torch_image()\n   project tensor -> PyTorch NCHW image\n2. active_model(torch_image)\n   forward pass -> logits\n3. CrossEntropyLoss(...)\n   logits + true label -> loss\n4. loss.backward()\n   backpropagation -> gradients\n5. optimizer.step()\n   gradients + learning rate -> changed weights\n\nClick this box for the concept doc. Function boxes link directly to\ncode.", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Inside one training update\nConcept doc: PyTorch Training Step Proof\n\n1. galaxy_tensor_to_torch_image()\n   project tensor -> PyTorch NCHW image\n2. active_model(torch_image)\n   forward pass -> logits\n3. CrossEntropyLoss(...)\n   logits + true label -> loss\n4. loss.backward()\n   backpropagation -> gradients\n5. optimizer.step()\n   gradients + learning rate -> changed weights\n\nClick this box for the concept doc. Function boxes link directly to code.", "lineHeight": 1.25, "autoResize": false, "rawText": "Inside one training update\nConcept doc: PyTorch Training Step Proof\n\n1. galaxy_tensor_to_torch_image()\n   project tensor -> PyTorch NCHW image\n2. active_model(torch_image)\n   forward pass -> logits\n3. CrossEntropyLoss(...)\n   logits + true label -> loss\n4. loss.backward()\n   backpropagation -> gradients\n5. optimizer.step()\n   gradients + learning rate -> changed weights\n\nClick this box for the concept doc. Function boxes link directly to code.", "roundness": null}, {"id": "eval-bg", "type": "rectangle", "x": 1030, "y": 1280, "width": 420, "height": 120, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#d0ebff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 45017, "version": 2, "versionNonce": 711215016, "isDeleted": false, "boundElements": [], "updated": 1788338966931, "link": null, "locked": false, "index": "aH", "roundness": {"type": 3}, "hasTextLink": false}, {"id": "GsKjQlJD", "type": "text", "x": 1050, "y": 1300, "width": 360, "height": 60, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 45018, "version": 2, "versionNonce": 1386440408, "isDeleted": false, "boundElements": [], "updated": 1788338966931, "link": null, "locked": false, "index": "aI", "hasTextLink": false, "text": "evaluate_torch_model()\nRead-only check after loop.\nNo gradients, no weight update.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "evaluate_torch_model()\nRead-only check after loop.\nNo gradients, no weight update.", "lineHeight": 1.25, "autoResize": false, "rawText": "", "roundness": null}, {"id": "aPb3LQSk", "type": "rectangle", "x": 1030, "y": 1440, "width": 420, "height": 150, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 45019, "version": 3, "versionNonce": 684528296, "isDeleted": false, "boundElements": [], "updated": 1788338966931, "link": null, "locked": false, "index": "aJ", "roundness": {"type": 3}, "hasTextLink": false}, {"id": "EWWZRvcB", "type": "text", "x": 1050, "y": 1460, "width": 360, "height": 100, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 45020, "version": 3, "versionNonce": 1681968088, "isDeleted": false, "boundElements": [], "updated": 1788338966931, "link": null, "locked": false, "index": "aK", "hasTextLink": false, "text": "run_torch_checkpoint_round_trip()\nUses trained loop_model.\nsave_torch_checkpoint()\nload_torch_checkpoint()\ncompare predictions.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "run_torch_checkpoint_round_trip()\nUses trained loop_model.\nsave_torch_checkpoint()\nload_torch_checkpoint()\ncompare predictions.", "lineHeight": 1.25, "autoResize": false, "rawText": "", "roundness": null}, {"id": "UxgPPjW8", "type": "text", "x": 920, "y": 430, "width": 430, "height": 20, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid"