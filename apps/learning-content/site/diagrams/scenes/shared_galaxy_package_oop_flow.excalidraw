on object.\nCarries predicted label,\nlogits, and probabilities.", "lineHeight": 1.25, "autoResize": false, "rawText": "", "roundness": null}, {"id": "gx76KC2H", "type": "text", "x": 60, "y": 1180, "width": 420, "height": 30, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 43020, "version": 2, "versionNonce": 2047599723, "isDeleted": false, "boundElements": [], "updated": 1787049683231, "link": null, "locked": false, "index": "aK", "hasTextLink": false, "text": "3. Function call graph", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "3. Function call graph", "lineHeight": 1.25, "autoResize": false, "rawText": "", "roundness": null}, {"id": "call-graph-clean-pointer", "type": "text", "x": 60, "y": 1215, "width": 760, "height": 40, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 43120, "version": 1, "versionNonce": 4312001, "isDeleted": false, "boundElements": [], "updated": 1787046000000, "link": "/learn/diagrams/#galaxy_training_function_call_graph", "locked": false, "index": "aK1", "hasTextLink": false, "text": "For the clearer dedicated training graph, open galaxy_training_function_call_graph.excalidraw", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "For the clearer dedicated training graph, open galaxy_training_function_call_graph.excalidraw", "lineHeight": 1.25, "autoResize": false, "rawText": "", "roundness": null}, {"id": "11gEzVGS", "type": "text", "x": 60, "y": 1240, "width": 420, "height": 200, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "stro