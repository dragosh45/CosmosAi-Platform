e, "text": "DATA: RGB pixels + labels stay unchanged\nTEMPORARY ACTIVATIONS: response maps, features, logits and loss are recalculated\nPARAMETERS: convolution weights/biases and classifier weights/biases survive and learn", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "DATA: RGB pixels + labels stay unchanged\nTEMPORARY ACTIVATIONS: response maps, features, logits and loss are recalculated\nPARAMETERS: convolution weights/biases and classifier weights/biases survive and learn", "lineHeight": 1.25, "autoResize": false, "rawText": "DATA: RGB pixels + labels stay unchanged\nTEMPORARY ACTIVATIONS: response maps, features, logits and loss are recalculated\nPARAMETERS: convolution weights/biases and classifier weights/biases survive and learn"}, {"id": "pass-heading", "type": "text", "x": 70, "y": 445, "width": 2260, "height": 42, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510008, "version": 1, "versionNonce": 511008, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "d08", "hasTextLink": true, "text": "1. Epoch 1 / optimizer update 1: forward pass uses current values but changes none", "fontSize": 30, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "1. Epoch 1 / optimizer update 1: forward pass uses current values but changes none", "lineHeight": 1.25, "autoResize": false, "rawText": "1. Epoch 1 / optimizer update 1: forward pass uses current values but changes none"}, {"id": "rgb-box", "type": "rectangle", "x": 70, "y": 520, "width": 290, "height": 310, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#d0ebff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "