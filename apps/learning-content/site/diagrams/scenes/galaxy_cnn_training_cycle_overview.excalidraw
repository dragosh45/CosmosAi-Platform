": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "new = old - 0.1 * gradient\nconv: -0.102860 -> -0.104348\nclassifier: -0.234997 -> -0.228845\nRGB pixels, labels, ReLU and pooling do not become weights.", "lineHeight": 1.25, "autoResize": false, "rawText": "new = old - 0.1 * gradient\nconv: -0.102860 -> -0.104348\nclassifier: -0.234997 -> -0.228845\nRGB pixels, labels, ReLU and pooling do not become weights."}, {"id": "a-back-opt", "type": "arrow", "x": 1570, "y": 1055, "width": 110, "height": 0, "angle": 0, "strokeColor": "#e67700", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510062, "version": 1, "versionNonce": 511062, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "d62", "points": [[0, 0], [-110, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "loop-arrow", "type": "arrow", "x": 700, "y": 1075, "width": 400, "height": 225, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "dashed", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510063, "version": 1, "versionNonce": 511063, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "d63", "points": [[0, 0], [-400, 0], [-400, -225], [-230, -225]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "loop-label", "type": "text", "x": 85, "y": 865, "width": 570, "height": 65, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510064, "version": 1, "versionNonce": 511064, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "d64", "hasTextLink": false, "text": "NEXT EPOCH: iterate the DataLoader again.\nSame stored RGB; updated model parameters.", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "NEXT EPOCH: iterate the DataLoader again.\nSame stored RGB; updated model parameters.", "lineHeight": 1.25, "autoResize": false, "rawText": "NEXT EPOCH: iterate the DataLoader again.\nSame stored RGB; updated model parameters."}, {"id": "update2-box", "type": "rectangle", "x": 70, "y": 1270, "width": 2260, "height": 330, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "#f3f0ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510065, "version": 1, "versionNonce": 511065, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "d65", "roundness": {"type": 3}}, {"id": "update2-title", "type": "text", "x": 100, "y": 1295, "width": 2180, "height": 42, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510066, "version": 1, "versionNonce": 511066, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "d66", "hasTextLink": false, "text": "4. Epoch 2 / optimizer update 2: repeat the SAME cycle from the updated state", "fontSize": 28, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "4. Epoch 2 / optimizer update 2: repeat the SAME cycle from the updated state", "lineHeight": 1.25, "autoResize": false, "rawText": "4. Epoch 2 / optimizer update 2: repeat the SAME cycle from the updated state"}, {"id": "update2-col1", "type": "text", "x": 110, "y": 1360, "width": 650, "height": 180, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510067, "version": 1, "versionNonce": 511067, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "d67", "hasTextLink": false, "text": "FORWARD AGAIN\nsame image A pixels\nnew conv filters -> a1 0.261860\nnew classifier -> P(spiral) 0.303674\nbatch loss before step 1.420960", "fontSize": 21, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "FORWARD AGAIN\nsame image A pixels\nnew conv filters -> a1 0.261860\nnew classifier -> P(spiral) 0.303674\nbatch loss before step 1.420960", "lineHeight": 1.25, "autoResize": false, "rawText": "FORWARD AGAIN\nsame image A pixels\nnew conv filters -> a1 0.261860\nnew classifier -> P(spiral) 0.303674\nbatch loss before step 1.420960"}, {"id": "update2-col2", "type": "text", "x": 835, "y": 1360, "width": 650, "height": 180, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510068, "version": 1, "versionNonce": 511068, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "d68", "hasTextLink": false, "text": "NEW GRADIENTS\nconv example +0.012733\nclassifier example -0.055341\nGradients change because the current\nweights, activations and loss changed.", "fontSize": 21, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "NEW GRADIENTS\nconv example +0.012733\nclassifier example -0.055341\nGradients change because the current\nweights, activations and loss changed.", "lineHeight": 1.25, "autoResize": false, "rawText": "NEW GRADIENTS\nconv example +0.012733\nclassifier example -0.055341\nGradients change because the current\nweights, activations and loss changed."}, {"id": "update2-col3", "type": "text", "x": 1560, "y": 1360, "width": 700, "height": 180, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510069, "version": 1, "versionNonce": 511069, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "d69", "hasTextLink": false, "text": "SGD AGAIN\nconv -> -0.105621\nclassifier -> -0.223311\nafter-step a1 0.246251; P(spiral) 0.311672\nsame-batch loss 1.387335", "fontSize": 21, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "SGD AGAIN\nconv -> -0.105621\nclassifier -> -0.223311\nafter-step a1 0.246251; P(spiral) 0.311672\nsame-batch loss 1.387335", "lineHeight": 1.25, "autoResize": false, "rawText": "SGD AGAIN\nconv -> -0.105621\nclassifier -> -0.223311\nafter-step a1 0.246251; P(spiral) 0.311672\nsame-batch loss 1.387335"}, {"id": "concept-link", "type": "text", "x": 70, "y": 1650, "width": 900, "height": 35, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510070, "version": 1, "versionNonce": 511070, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "d70", "hasTextLink": true, "text": "Concept: whole tiny CNN training cycle", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Concept: whole tiny CNN training cycle", "lineHeight": 1.25, "autoResize": false, "rawText": "Concept: whole tiny CNN training cycle"}, {"id": "detail-link", "type": "text", "x": 1080, "y": 1650, "width": 850, "height": 35, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510071, "version": 1, "versionNonce": 511071, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": "/learn/diagrams/#galaxy_cnn_exact_weight_updates", "locked": false, "index": "d71", "hasTextLink": true, "text": "Detailed observed matrices and every weight", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Detailed observed matrices and every weight", "lineHeight": 1.25, "autoResize": false, "rawText": "Detailed observed matrices and every weight"}, {"id": "boundary-note", "type": "text", "x": 70, "y": 1710, "width": 2260, "height": 70, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510072, "version": 1, "versionNonce": 511072, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "d72", "hasTextLink": false, "text": "Boundary: these are tiny synthetic fixtures used to expose mechanics, not real-galaxy accuracy. M51 changes when files decode from disk; it does not change this learning cycle.", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Boundary: these are tiny synthetic fixtures used to expose mechanics, not real-galaxy accuracy. M51 changes when files decode from disk; it does not change this learning cycle.", "lineHeight": 1.25, "autoResize": false, "rawText": "Boundary: these are tiny synthetic fixtures used to expose mechanics, not real-galaxy accuracy. M51 changes when files decode from disk; it does not change this learning cycle."}, {"id": "shared-gradient-box", "type": "rectangle", "x": 70, "y": 1810, "width": 2260, "height": 250, "angle": 0, "strokeColor": "#5f3dc4", "backgroundColor": "#e5dbff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510073, "version": 1, "versionNonce": 511073, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "d73", "roundness": {"type": 3}}, {"id": "shared-gradient-title", "type": "text", "x": 105, "y": 1835, "width": 2150, "height": 35, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510074, "version": 1, "versionNonce": 511074, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "d74", "hasTextLink": false, "text": "Why 108 convolution weights learn separately: one shared weight has many uses", "fontSize": 26, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Why 108 convolution weights learn separately: one shared weight has many uses", "lineHeight": 1.25, "autoResize": false, "rawText": "Why 108 convolution weights learn separately: one shared weight has many uses"}, {"id": "shared-gradient-body", "type": "text", "x": 105, "y": 1880, "width": 2150, "height": 110, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510075, "version": 1, "versionNonce": 511075, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "d75", "hasTextLink": false, "text": "108 = 4 filters x 3 RGB slices x 3x3. K[0,0,1,1] is reused at 9 positions per image (18 uses in this batch; padding can make an aligned input 0).\nbackward adds every local contribution: sum(dL/dz * aligned input) = +0.014876489. SGD: -0.102860123 - 0.1*(+0.014876489) = -0.104347773.", "fontSize": 21, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "108 = 4 filters x 3 RGB slices x 3x3. K[0,0,1,1] is reused at 9 positions per image (18 uses in this batch; padding can make an aligned input 0).\nbackward adds every local contribution: sum(dL/dz * aligned input) = +0.014876489. SGD: -0.102860123 - 0.1*(+0.014876489) = -0.104347773.", "lineHeight": 1.25, "autoResize": false, "rawText": "108 = 4 filters x 3 RGB slices x 3x3. K[0,0,1,1] is reused at 9 positions per image (18 uses in this batch; padding can make an aligned input 0).\nbackward adds every local contribution: sum(dL/dz * aligned input) = +0.014876489. SGD: -0.102860123 - 0.1*(+0.014876489) = -0.104347773."}, {"id": "shared-gradient-link", "type": "text", "x": 105, "y": 2010, "width": 1120, "height": 28, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510076, "version": 1, "versionNonce": 511076, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "d76", "hasTextLink": true, "text": "Concept: all 18 shared-weight gradient contributions", "fontSize": 21, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Concept: all 18 shared-weight gradient contributions", "lineHeight": 1.25, "autoResize": false, "rawText": "Concept: all 18 shared-weight gradient contributions"}], "appState": {"viewBackgroundColor": "#ffffff"}, "files": {}}