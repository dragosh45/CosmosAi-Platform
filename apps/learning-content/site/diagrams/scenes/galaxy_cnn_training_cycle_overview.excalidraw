{"type": "excalidraw", "version": 2, "source": "CosmosAI learning export", "elements": [{"id": "cycle-title", "type": "text", "x": 70, "y": 35, "width": 2260, "height": 55, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510000, "version": 1, "versionNonce": 511000, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "d00", "hasTextLink": false, "text": "Our tiny CNN: one complete training cycle, then the next update", "fontSize": 40, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Our tiny CNN: one complete training cycle, then the next update", "lineHeight": 1.25, "autoResize": false, "rawText": "Our tiny CNN: one complete training cycle, then the next update"}, {"id": "cycle-subtitle", "type": "text", "x": 70, "y": 100, "width": 2260, "height": 62, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 510001, "version": 1, "versionNonce": 511001, "isDeleted": false, "boundElements": [], "updated": 1788998400000, "link": null, "locked": false, "index": "d01", "hasTextLink": false, "text": "Same stored RGB batch every epoch. Forward calculates; backward calculates gradients; SGD changes both trainable parameter groups.", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Same stored RGB batch every epoch. Forward calculates; backward calculates gradients; SGD changes both trainable parameter groups.", "lineHeight": 1.25, "autoResize": false, "rawText": "Same stored RGB batch every epoch. Forward calculates; backward calculates gradients; SGD changes both trainable parameter groups."}, {