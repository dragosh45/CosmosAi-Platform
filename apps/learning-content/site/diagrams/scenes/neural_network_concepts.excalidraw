": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "points": [[0, 0], [85, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "arrow-layer-2", "type": "arrow", "x": 500, "y": 470, "width": 75, "height": 0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 117, "version": 1, "versionNonce": 11717, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "points": [[0, 0], [75, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "arrow-layer-3", "type": "arrow", "x": 775, "y": 470, "width": 75, "height": 0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 118, "version": 1, "versionNonce": 11818, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "points": [[0, 0], [75, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "section-training", "type": "text", "x": 40, "y": 630, "width": 640, "height": 30, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 119, "version": 1, "versionNonce": 11919, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "3. Training: labeled data teaches the weights", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "3. Training: labeled data teaches the weights", "lineHeight": 1.25}, {"id": "text-training-flow", "type": "text", "x": 65, "y": 695, "width": 930, "height": 250, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 120, "version": 1, "versionNonce": 12020, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "galaxy_001.jpg + correct label: spiral\n        |\n        v\nnetwork predicts: spiral 0.20, elliptical 0.70\n        |\n        v\nloss/error: prediction is wrong\n        |\n        v\nbackpropagation: figure out which weights contributed to the error\n        |\n        v\ngradient descent: nudge weights slightly\n        |\n        v\nrepeat over many labeled images", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "galaxy_001.jpg + correct label: spiral\n        |\n        v\nnetwork predicts: spiral 0.20, elliptical 0.70\n        |\n        v\nloss/error: prediction is wrong\n        |\n        v\nbackpropagation: figure out which weights contributed to the error\n        |\n        v\ngradient descent: nudge weights slightly\n        |\n        v\nrepeat over many labeled images", "lineHeight": 1.25}, {"id": "section-cnn", "type": "text", "x": 40, "y": 1010, "width": 650, "height": 30, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 121, "version": 1, "versionNonce": 12121, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "4. Galaxy CNN: pixels become larger visual patterns", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "4. Galaxy CNN: pixels become larger visual patterns", "lineHeight": 1.25}, {"id": "text-cnn-flow", "type": "text", "x": 65, "y": 1075, "width": 900, "height": 240, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 122, "version": 1, "versionNonce": 12222, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "RGB galaxy image\n  |\n  v\nearly CNN filters: brightness changes, edges\n  |\n  v\nmiddle CNN filters: curves, arcs, bright center\n  |\n  v\nlater CNN filters: spiral arms, smooth blob, irregular structure\n  |\n  v\noutput scores: spiral / elliptical / lenticular / irregular", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "RGB galaxy image\n  |\n  v\nearly CNN filters: brightness changes, edges\n  |\n  v\nmiddle CNN filters: curves, arcs, bright center\n  |\n  v\nlater CNN filters: spiral arms, smooth blob, irregular structure\n  |\n  v\noutput scores: spiral / elliptical / lenticular / irregular", "lineHeight": 1.25}, {"id": "section-service", "type": "text", "x": 40, "y": 1390, "width": 760, "height": 30, "angle": 0, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 123, "version": 1, "versionNonce": 12323, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "5. Later in CosmosAI: trained checkpoint connects to the service", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "5. Later in CosmosAI: trained checkpoint connects to the service", "lineHeight": 1.25}, {"id": "text-service-flow", "type": "text", "x": 65, "y": 1455, "width": 900, "height": 190, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 124, "version": 1, "versionNonce": 12424, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "training produces: galaxy_cnn_checkpoint.pt\n        |\n        v\ngalaxy-classifier-service loads checkpoint\n        |\n        v\nPOST /classify with image_id or image_uri\n        |\n        v\nservice returns label + confidence\n{ label: \"spiral\", confidence: 0.82, status: \"ok\" }", "fontSize": 22, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "training produces: galaxy_cnn_checkpoint.pt\n        |\n        v\ngalaxy-classifier-service loads checkpoint\n        |\n        v\nPOST /classify with image_id or image_uri\n        |\n        v\nservice returns label + confidence\n{ label: \"spiral\", confidence: 0.82, status: \"ok\" }", "lineHeight": 1.25}], "appState": {"viewBackgroundColor": "#ffffff"}, "files": {}}