{"type": "excalidraw", "version": 2, "source": "CosmosAI learning export", "elements": [{"id": "title", "type": "text", "x": 60, "y": 40, "width": 1420, "height": 44, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 49000001, "version": 1, "versionNonce": 490000011, "isDeleted": false, "boundElements": [], "updated": 1787155000000, "link": null, "locked": false, "index": "a1", "hasTextLink": false, "text": "CNN Weight Change: From One Connection To Filters And Layers", "fontSize": 34, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "CNN Weight Change: From One Connection To Filters And Layers", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "subtitle", "type": "text", "x": 60, "y": 96, "width": 1660, "height": 30, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 49000002, "version": 1, "versionNonce": 490000021, "isDeleted": false, "boundElements": [], "updated": 1787155000000, "link": "/learn/concepts/#concept-cnn-filter-weights", "locked": false, "index": "a2", "hasTextLink": true, "text": "Concept doc: a weight controls one connection/filter value; training changes many weights differently.", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Concept doc: a weight controls one connection/filter value; training changes many weights differently.", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "row1-title", "type": "text", "x": 60, "y": 160, "width": 720, "height": 34, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "