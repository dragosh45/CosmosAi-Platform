e, "boundElements": [], "updated": 1787155000000, "link": null, "locked": false, "index": "a9", "points": [[0, 0], [680, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "old-label", "type": "text", "x": 440, "y": 242, "width": 340, "height": 28, "angle": 0, "strokeColor": "#495057", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 49000010, "version": 1, "versionNonce": 490000101, "isDeleted": false, "boundElements": [], "updated": 1787155000000, "link": null, "locked": false, "index": "a10", "hasTextLink": false, "text": "before: weight 0.20 -> signal 0.8 * 0.20 = 0.16", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "before: weight 0.20 -> signal 0.8 * 0.20 = 0.16", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "new-label", "type": "text", "x": 440, "y": 352, "width": 370, "height": 28, "angle": 0, "strokeColor": "#e03131", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 49000011, "version": 1, "versionNonce": 490000111, "isDeleted": false, "boundElements": [], "updated": 1787155000000, "link": null, "locked": false, "index": "a11", "hasTextLink": false, "text": "after: weight 0.23 -> signal 0.8 * 0.23 = 0.184", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "after: weight 0.23 -> signal 0.8 * 0.23 = 0.184", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "row2-title", "type": "text", "x": 60, "y": 455, "width": 1060, "height": 34, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 49000012, "version": 1, "versionNonce": 490000121, "isDeleted": false, "boundElements": [], "updated": 1787155000000, "link": "/learn/concepts/#concept-cnn-filter-weights", "locked": false, "index": "a12", "hasTextLink": true, "text": "2. CNN first layer: weights are filter numbers, shared across image positions", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "2. CNN first layer: weights are filter numbers, shared across image positions", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "patch-box", "type": "rectangle", "x": 60, "y": 525, "width": 370, "height": 250, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 49000013, "version": 1, "versionNonce": 490000131, "isDeleted": false, "boundElements": [], "updated": 1787155000000, "link": null, "locked": false, "index": "a13", "roundness": {"type": 3}}, {"id": "patch-text", "type": "text", "x": 88, "y": 553, "width": 315, "height": 184, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 49000014, "version": 1, "versionNonce": 490000141, "isDeleted": false, "boundElements": [], "updated": 1787155000000, "link": null, "locked": false, "index": "a14", "hasTextLink": false, "text": "RGB image patch\n\n3 x 3 pixels\n3 channels per pixel\n\nOne pixel:\nR = 0.8\nG = 0.7\nB = 0.6\n\nInput values are not learned.", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "RGB image patch\n\n3 x 3 pixels\n3 channels per pixel\n\nOne pixel:\nR = 0.8\nG = 0.7\nB = 0.6\n\nInput values are not learned.", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "filter-box", "type": "rectangle", "x": 550, "y": 525, "width": 450, "height": 250, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 49000015, "version": 2, "versionNonce": 490000151, "isDeleted": false, "boundElements": [], "updated": 1787155000000, "link": null, "locked": false, "index": "a15", "roundness": {"type": 3}}, {"id": "filter-text", "type": "text", "x": 578, "y": 553, "width": 390, "height": 184, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 49000016, "version": 2, "versionNonce": 490000161, "isDeleted": false, "boundElements": [], "updated": 1787155000000, "link": null, "locked": false, "index": "a16", "hasTextLink": true, "text": "Conv filter weights\n\nBefore training step:\nred-center weight 0.20\nblue-corner weight -0.10\nedge weight 0.05\n\nAfter optimizer.step:\n0.20 -> 0.23  up\n-0.10 -> -0.18  down/more negative\n0.05 -> 0.051  almost same", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Conv filter weights\n\nBefore training step:\nred-center weight 0.20\nblue-corner weight -0.10\nedge weight 0.05\n\nAfter optimizer.step:\n0.20 -> 0.23  up\n-0.10 -> -0.18  down/more negative\n0.05 -> 0.051  almost same", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "feature-box", "type": "rectangle", "x": 1120, "y": 525, "width": 430, "height": 250, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#d3f9d8", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 49000017, "version": 2, "versionNonce": 490000171, "isDeleted": false, "boundElements": [], "updated": 1787155000000, "link": null, "locked": false, "index": "a17", "roundness": {"type": 3}}, {"id": "feature-text", "type": "text", "x": 1148, "y": 553, "width": 370, "height": 184, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 49000018, "version": 2, "versionNonce": 490000181, "isDeleted": false, "boundElements": [], "updated": 1787155000000, "link": null, "locked": false, "index": "a18", "hasTextLink": true, "text": "Feature map activation\n\nsum(pixel * filter_weight) + bias\n\nIf updated weights match this local pattern better,\nactivation can become stronger.\n\nSame filter slides over many image positions.", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Feature map activation\n\nsum(pixel * filter_weight) + bias\n\nIf updated weights match this local pattern better,\nactivation can become stronger.\n\nSame filter slides over many image positions.", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "not-pixel-box", "type": "rectangle", "x": 1660, "y": 525, "width": 520, "height": 250, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ffe3e3", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 49000019, "version": 1, "versionNonce": 490000191, "isDeleted": false, "boundElements": [], "updated": 1787155000000, "link": "/learn/concepts/#concept-cnn-filter-weights", "locked": false, "index": "a19", "roundness": {"type": 3}}, {"id": "not-pixel-text", "type": "text", "x": 1688, "y": 553, "width": 460, "height": 184, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 49000020, "version": 1, "versionNonce": 490000201, "isDeleted": false, "boundElements": [], "updated": 1787155000000, "link": "/learn/concepts/#concept-cnn-filter-weights", "locked": false, "index": "a20", "hasTextLink": true, "text": "Important correction\n\nNot exactly:\n\"this one pixel is always important\"\n\nBetter:\n\"this learned filter responds more or less to this local RGB pattern.\"\n\nThat pattern can appear anywhere the filter slides.", "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Important correction\n\nNot exactly:\n\"this one pixel is always important\"\n\nBetter:\n\"this learned filter responds more or less to this local RGB pattern.\"\n\nThat pattern can appear anywhere the filter slides.", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "row3-title", "type": "text", "x": 60, "y": 850, "width": 900, "height": 34, "angle": 0, "strokeColor": "#6741d9", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 49000021, "version": 2, "versionNonce": 490000211, "isDeleted": false, "boundElements": [], "updated": 1787155000000, "link": null, "locked": false, "index": "a21", "hasTextLink": true, "text": "3. Whole tiny CNN: many weights update, not one global weight change", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "3. Whole tiny CNN: many weights update, not one global weight change", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "cnn-flow-box", "type": "rectangle", "x": 60, "y": 920, "width": 1780, "height": 220, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 49000022, "version": 1, "versionNonce": 490000221, "isDeleted": false, "boundElements": [], "updated": 1787155000000, "link": null, "locked": false, "index": "a22", "roundness": {"type": 3}}, {"id": "cnn-flow-text", "type": "text", "x": 90, "y": 952, "width": 1720, "height": 150, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 49000023, "version": 1, "versionNonce": 490000231, "isDeleted": false, "boundElements": [], "updated": 1787155000000, "link": null, "locked": false, "index": "a23", "hasTextLink": false, "text": "image tensor -> Conv2d filter weights -> ReLU/pool features -> classifier weights -> logits -> loss\n                         ^                                                              |\n                         |                                                              v\n                 some conv weights up/down                                 loss.backward() calculates gradients\n                 some classifier weights up/down                            optimizer.step() updates weights\n\nNext forward pass uses changed weights, so logits/probabilities can be different.", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "image tensor -> Conv2d filter weights -> ReLU/pool features -> classifier weights -> logits -> loss\n                         ^                                                              |\n                         |                                                              v\n                 some conv weights up/down                                 loss.backward() calculates gradients\n                 some classifier weights up/down                            optimizer.step() updates weights\n\nNext forward pass uses changed weights, so logits/probabilities can be different.", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "code-links", "type": "text", "x": 60, "y": 1185, "width": 1700, "height": 84, "angle": 0, "strokeColor": "#1864ab", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 49000024, "version": 2, "versionNonce": 490000241, "isDeleted": false, "boundElements": [], "updated": 1787155000000, "link": null, "locked": false, "index": "a24", "hasTextLink": true, "text": "Code link: click here for loss.backward(); filter/classifier boxes above link to TinyGalaxyCNN Conv2d and classifier code.", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Code link: click here for loss.backward(); filter/classifier boxes above link to TinyGalaxyCNN Conv2d and classifier code.", "lineHeight": 1.25, "autoResize": false, "rawText": ""}, {"id": "arrow-patch-filter", "type": "arrow", "x": 440, "y": 650, "width": 100, "height": 0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 49000025, "version": 1, "versionNonce": 490000251, "isDeleted": false, "boundElements": [], "updated": 1787155000000, "link": null, "locked": false, "index": "a25", "points": [[0, 0], [100, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow"}, {"id": "arrow-filter-feature", "type": "arrow", "x": 1010, "y": 650, "width": 100, "height": 0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "seed": 49000026, "version": 1, "versionNonce": 490000261, "isDeleted": false, "boundElements": [], "updated": 1787155000000, "link": null, "locked": false, 