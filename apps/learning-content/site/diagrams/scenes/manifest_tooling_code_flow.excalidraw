72, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "index": "a2", "hasTextLink": false}, {"id": "r0PEgJoJ", "type": "text", "x": 80, "y": 195, "width": 329.3127136230469, "height": 220, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 4104, "version": 2, "versionNonce": 946917724, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "text": "validate_galaxy_manifest.py\n\nPurpose:\nprotects the project from bad CSV data.\n\nmain()\n  parse_args()\n  validate_manifest(path)\n\nOutput:\nvalid or list of errors", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "validate_galaxy_manifest.py\n\nPurpose:\nprotects the project from bad CSV data.\n\nmain()\n  parse_args()\n  validate_manifest(path)\n\nOutput:\nvalid or list of errors", "lineHeight": 1.25, "autoResize": true, "index": "a3", "hasTextLink": false, "rawText": ""}, {"id": "manifest-box", "type": "rectangle", "x": 530, "y": 170, "width": 390, "height": 230, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 4105, "version": 2, "versionNonce": 1623491172, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "index": "a4", "hasTextLink": false}, {"id": "Gq3OB6cf", "type": "text", "x": 555, "y": 195, "width": 454.3369140625, "height": 240, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 4106, "version": 2, "versionNonce": 1569080796, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "text": "load_galaxy_manifest.py\n\nPurpose:\nturns validated CSV rows into Python records and paths.\n\nmain()\n  load_manifest(path)\n  records_by_split(...)\n  resolved_image_paths_by_id(...)\n\nOutput:\nGalaxyManifestRecord list", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "load_galaxy_manifest.py\n\nPurpose:\nturns validated CSV rows into Python records and paths.\n\nmain()\n  load_manifest(path)\n  records_by_split(...)\n  resolved_image_paths_by_id(...)\n\nOutput:\nGalaxyManifestRecord list", "lineHeight": 1.25, "autoResize": true, "index": "a5", "hasTextLink": false, "rawText": ""}, {"id": "image-box", "type": "rectangle", "x": 1050, "y": 170, "width": 390, "height": 250, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ebfbee", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 4107, "version": 2, "versionNonce": 1498322404, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "index": "a6", "hasTextLink": false}, {"id": "d3Mu48nz", "type": "text", "x": 1075, "y": 195, "width": 461.28094482421875, "height": 260, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 4108, "version": 2, "versionNonce": 418982492, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "text": "load_galaxy_image.py\n\nPurpose:\nstarts from one manifest record and loads its tiny image.\n\nmain()\n  load_manifest(path)\n  find image_id\n  load_image_for_record(...)\n  load_ppm_image(...)\n\nOutput:\nGalaxyImage", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "load_galaxy_image.py\n\nPurpose:\nstarts from one manifest record and loads its tiny image.\n\nmain()\n  load_manifest(path)\n  find image_id\n  load_image_for_record(...)\n  load_ppm_image(...)\n\nOutput:\nGalaxyImage", "lineHeight": 1.25, "autoResize": true, "index": "a7", "hasTextLink": false, "rawText": ""}, {"id": "arrow-1", "type": "arrow", "x": 410, "y": 275, "width": 115, "height": 0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 4109, "version": 2, "versionNonce": 1850358116, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "points": [[0, 0], [115, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "index": "a8", "hasTextLink": false}, {"id": "arrow-2", "type": "arrow", "x": 925, "y": 285, "width": 120, "height": 0, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 3, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 2}, "seed": 4110, "version": 2, "versionNonce": 496729820, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "points": [[0, 0], [120, 0]], "lastCommittedPoint": null, "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": "arrow", "index": "a9", "hasTextLink": false}, {"id": "lCJlFLUy", "type": "text", "x": 55, "y": 500, "width": 169.7755126953125, "height": 30, "angle": 0, "strokeColor": "#5f3dc4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 4111, "version": 2, "versionNonce": 990211300, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "text": "2. Object flow", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "2. Object flow", "lineHeight": 1.25, "autoResize": true, "index": "aA", "hasTextLink": false, "rawText": ""}, {"id": "object-box", "type": "rectangle", "x": 55, "y": 560, "width": 1385, "height": 120, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#f8f9fa", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 4112, "version": 2, "versionNonce": 1946108764, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "index": "aB", "hasTextLink": false}, {"id": "w4VUrjhG", "type": "text", "x": 80, "y": 590, "width": 1742.558349609375, "height": 25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 4113, "version": 2, "versionNonce": 1091448932, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "text": "CSV row  ->  GalaxyManifestRecord(image_id, image_path, label, split, source)  ->  resolved image path  ->  PPM tokens  ->  GalaxyImage(path, width, height, channels, pixels)", "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "CSV row  ->  GalaxyManifestRecord(image_id, image_path, label, split, source)  ->  resolved image path  ->  PPM tokens  ->  GalaxyImage(path, width, height, channels, pixels)", "lineHeight": 1.25, "autoResize": true, "index": "aC", "hasTextLink": false, "rawText": ""}, {"id": "B0wNux6t", "type": "text", "x": 55, "y": 750, "width": 306.6470947265625, "height": 30, "angle": 0, "strokeColor": "#5f3dc4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 4114, "version": 2, "versionNonce": 1115060188, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "text": "3. Detailed function roles", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "3. Detailed function roles", "lineHeight": 1.25, "autoResize": true, "index": "aD", "hasTextLink": false, "rawText": ""}, {"id": "roles-box", "type": "rectangle", "x": 55, "y": 810, "width": 1385, "height": 520, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff3bf", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 4115, "version": 2, "versionNonce": 540181476, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "index": "aE", "hasTextLink": false}, {"id": "sg5ndMqj", "type": "text", "x": 85, "y": 845, "width": 384.375, "height": 300, "angle": 0, "strokeColor": "#5f3dc4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 4116, "version": 2, "versionNonce": 353573980, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "text": "validate_manifest(path)\n\nparse_args()\n\nmain()\n\nload_manifest(path)\n\nrecords_by_split(records)\n\nresolve_image_path(record, root)\n\nresolved_image_paths_by_id(records, root)\n\nmissing_image_paths(records, root)", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "validate_manifest(path)\n\nparse_args()\n\nmain()\n\nload_manifest(path)\n\nrecords_by_split(records)\n\nresolve_image_path(record, root)\n\nresolved_image_paths_by_id(records, root)\n\nmissing_image_paths(records, root)", "lineHeight": 1.25, "autoResize": true, "index": "aF", "hasTextLink": false, "rawText": ""}, {"id": "rvLKDVSY", "type": "text", "x": 430, "y": 845, "width": 465.72900390625, "height": 300, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 4117, "version": 2, "versionNonce": 1317037924, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "text": "Checks columns, labels, splits, duplicates, and empty fields.\n\nDefines command-line inputs for a script.\n\nRuns the script from the terminal.\n\nValidates CSV and creates GalaxyManifestRecord objects.\n\nGroups records into train, val, and test lists.\n\nJoins data root plus manifest image_path when needed.\n\nMaps each image_id to its resolved image path.\n\nReturns image paths that do not exist on disk.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Checks columns, labels, splits, duplicates, and empty fields.\n\nDefines command-line inputs for a script.\n\nRuns the script from the terminal.\n\nValidates CSV and creates GalaxyManifestRecord objects.\n\nGroups records into train, val, and test lists.\n\nJoins data root plus manifest image_path when needed.\n\nMaps each image_id to its resolved image path.\n\nReturns image paths that do not exist on disk.", "lineHeight": 1.25, "autoResize": true, "index": "aG", "hasTextLink": false, "rawText": ""}, {"id": "LFjCGylo", "type": "text", "x": 965, "y": 845, "width": 328.125, "height": 180, "angle": 0, "strokeColor": "#5f3dc4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 4118, "version": 2, "versionNonce": 631714012, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "text": "read_ppm_tokens(path)\n\nload_ppm_image(path)\n\nload_image_for_record(record, root)\n\nparse_args()\n\nmain()", "fontSize": 16, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "read_ppm_tokens(path)\n\nload_ppm_image(path)\n\nload_image_for_record(record, root)\n\nparse_args()\n\nmain()", "lineHeight": 1.25, "autoResize": true, "index": "aH", "hasTextLink": false, "rawText": ""}, {"id": "SXv4PuFe", "type": "text", "x": 1235, "y": 845, "width": 370.8167724609375, "height": 180, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 4119, "version": 2, "versionNonce": 1346755300, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "text": "Reads PPM text tokens and ignores comments.\n\nConverts PPM tokens into a GalaxyImage.\n\nResolves path and loads one image.\n\nDefines image loader terminal inputs.\n\nLoads one selected image and prints size.", "fontSize": 16, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Reads PPM text tokens and ignores comments.\n\nConverts PPM tokens into a GalaxyImage.\n\nResolves path and loads one image.\n\nDefines image loader terminal inputs.\n\nLoads one selected image and prints size.", "lineHeight": 1.25, "autoResize": true, "index": "aI", "hasTextLink": false, "rawText": ""}, {"id": "G3BuHHHO", "type": "text", "x": 55, "y": 1405, "width": 432.4307861328125, "height": 30, "angle": 0, "strokeColor": "#5f3dc4", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 4120, "version": 2, "versionNonce": 600094044, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "text": "4. Command args, helpers, and paths", "fontSize": 24, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "4. Command args, helpers, and paths", "lineHeight": 1.25, "autoResize": true, "index": "aJ", "hasTextLink": false, "rawText": ""}, {"id": "args-box", "type": "rectangle", "x": 55, "y": 1465, "width": 430, "height": 290, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#e7f5ff", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 4121, "version": 2, "versionNonce": 1880153700, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "index": "aK", "hasTextLink": false}, {"id": "Ytgwd0hL", "type": "text", "x": 80, "y": 1490, "width": 438.843017578125, "height": 206.25, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 4122, "version": 2, "versionNonce": 2092804572, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "text": "-- arguments\n\nWords starting with -- are named command-line options.\n\nBuilt with argparse:\nparser.add_argument(\"--image-id\", ...)\nparser.add_argument(\"--galaxy-data-root\", ...)\nparser.add_argument(\"--check-images\", action=\"store_true\")\n\nWhy:\nchange inputs without editing Python code.", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "-- arguments\n\nWords starting with -- are named command-line options.\n\nBuilt with argparse:\nparser.add_argument(\"--image-id\", ...)\nparser.add_argument(\"--galaxy-data-root\", ...)\nparser.add_argument(\"--check-images\", action=\"store_true\")\n\nWhy:\nchange inputs without editing Python code.", "lineHeight": 1.25, "autoResize": true, "index": "aL", "hasTextLink": false, "rawText": ""}, {"id": "helpers-box", "type": "rectangle", "x": 535, "y": 1465, "width": 400, "height": 290, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#ebfbee", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 4123, "version": 2, "versionNonce": 1991209444, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "index": "aM", "hasTextLink": false}, {"id": "y8PCQELP", "type": "text", "x": 560, "y": 1490, "width": 361.0225524902344, "height": 168.75, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 4124, "version": 2, "versionNonce": 597954140, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "text": "External helpers\n\nargparse: reads terminal options.\ncsv.DictReader: reads CSV rows by header name.\ndataclass: creates small data objects.\nPath: handles local/external file paths.\nsys.exit: returns terminal status code.\n\nAll are Python standard library.", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "External helpers\n\nargparse: reads terminal options.\ncsv.DictReader: reads CSV rows by header name.\ndataclass: creates small data objects.\nPath: handles local/external file paths.\nsys.exit: returns terminal status code.\n\nAll are Python standard library.", "lineHeight": 1.25, "autoResize": true, "index": "aN", "hasTextLink": false, "rawText": ""}, {"id": "paths-box", "type": "rectangle", "x": 985, "y": 1465, "width": 455, "height": 290, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "#fff9db", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": {"type": 3}, "seed": 4125, "version": 2, "versionNonce": 1664062820, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "index": "aO", "hasTextLink": false}, {"id": "QNcYxv56", "type": "text", "x": 1010, "y": 1490, "width": 451.171875, "height": 227.5, "angle": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 4126, "version": 2, "versionNonce": 1498014428, "isDeleted": false, "boundElements": [], "updated": 1782057384029, "link": null, "locked": false, "text": "Path examples\n\nmanifest image_path:\nprocessed/images_224/gz2-000001.ppm\n\nlocal root:\ndata/samples/images\n\nresolved local:\ndata/samples/images/processed/images_224/gz2-000001.ppm\n\nfuture external root:\n/media/h1dr0/KINGSTON/cosmosai-data/galaxy", "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Path examples\n\nmanifest image_path:\nprocessed/images_224/gz2-000001.ppm\n\nlocal root:\ndata/samples/images\n\nresolved local:\ndata/samples/images/processed/images_224/gz2-000001.ppm\n\nfuture external root:\n/media/h1dr0/KINGSTON/cosmosai-data/galaxy", "lineHeight": 1.25, "autoResize": true, "index": "aP", "hasTextLink": false, "rawText": ""}, {"id": "commands-box", "type": "rectangle", "x": 55, "y"