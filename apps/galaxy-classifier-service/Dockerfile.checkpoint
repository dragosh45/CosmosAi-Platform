# Start from the same lightweight Python base image as the normal service image.
FROM python:3.10-slim

# Set /app as the working directory inside the container.
WORKDIR /app

# Copy the optional checkpoint dependency list into the image.
COPY apps/galaxy-classifier-service/requirements-checkpoint.txt ./requirements.txt

# Install FastAPI, Uvicorn, and CPU-only PyTorch for checkpoint inference.
RUN pip install --no-cache-dir -r requirements.txt

# Copy the FastAPI service code into the image.
COPY apps/galaxy-classifier-service/main.py .

# Copy the shared CosmosAI package used by checkpoint inference.
COPY cosmosai ./cosmosai

# Document that the container listens on port 8000 internally.
EXPOSE 8000

# Start the FastAPI app with Uvicorn when the container runs.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
